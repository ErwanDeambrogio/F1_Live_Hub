<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!-- ═══════════════════════════════════ -->
	<!--          COULEURS PRINCIPALES       -->
	<!-- ═══════════════════════════════════ -->

	<!-- Rouge F1 -->
	<Color x:Key="F1Red">#E10600</Color>
	<SolidColorBrush x:Key="F1RedBrush" Color="#E10600"/>

	<!-- Fonds -->
	<Color x:Key="BackgroundDark">#0D0D0D</Color>
	<SolidColorBrush x:Key="BackgroundDarkBrush" Color="#0D0D0D"/>

	<Color x:Key="BackgroundCard">#1A1A1A</Color>
	<SolidColorBrush x:Key="BackgroundCardBrush" Color="#1A1A1A"/>

	<Color x:Key="BackgroundInput">#1C1C1C</Color>
	<SolidColorBrush x:Key="BackgroundInputBrush" Color="#1C1C1C"/>

	<!-- Textes -->
	<Color x:Key="TextWhite">#FFFFFF</Color>
	<SolidColorBrush x:Key="TextWhiteBrush" Color="#FFFFFF"/>

	<Color x:Key="TextGray">#888888</Color>
	<SolidColorBrush x:Key="TextGrayBrush" Color="#888888"/>

	<Color x:Key="TextLightGray">#AAAAAA</Color>
	<SolidColorBrush x:Key="TextLightGrayBrush" Color="#AAAAAA"/>

	<!-- Bordures -->
	<Color x:Key="BorderDark">#2A2A2A</Color>
	<SolidColorBrush x:Key="BorderDarkBrush" Color="#2A2A2A"/>

	<!-- Vert succès -->
	<Color x:Key="ColorGreen">#00C851</Color>
	<SolidColorBrush x:Key="ColorGreenBrush" Color="#00C851"/>

	<!-- Barre de navigation -->
	<Color x:Key="NavBackground">#111111</Color>
	<SolidColorBrush x:Key="NavBackgroundBrush" Color="#111111"/>

</ResourceDictionary>