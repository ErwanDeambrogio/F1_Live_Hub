<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!-- BOUTON ROUGE PRINCIPAL (CRÉER MON COMPTE, CONNEXION...) -->
	<Style x:Key="PrimaryButtonStyle" TargetType="Button">
		<Setter Property="Cursor" Value="Hand"/>
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="HorizontalAlignment" Value="Stretch"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border CornerRadius="12" Height="58" Background="#E10600">
						<ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- BOUTON SECONDAIRE CONTOUR (annuler, retour...) -->
	<Style x:Key="SecondaryButtonStyle" TargetType="Button">
		<Setter Property="Cursor" Value="Hand"/>
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="HorizontalAlignment" Value="Stretch"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border CornerRadius="12" Height="58"
                            Background="Transparent"
                            BorderBrush="#E10600"
                            BorderThickness="1.5">
						<ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- BOUTON PETIT (ANALYSES LIVE, tags...) -->
	<Style x:Key="SmallButtonStyle" TargetType="Button">
		<Setter Property="Cursor" Value="Hand"/>
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border CornerRadius="6" Background="#E10600" Padding="14,9">
						<ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- BOUTON ROND (retour en haut des pages) -->
	<Style x:Key="RoundButtonStyle" TargetType="Button">
		<Setter Property="Cursor" Value="Hand"/>
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Width" Value="42"/>
		<Setter Property="Height" Value="42"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border CornerRadius="21" Background="#22FFFFFF">
						<ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- TEXTE BOUTON PRINCIPAL -->
	<Style x:Key="PrimaryButtonTextStyle" TargetType="TextBlock">
		<Setter Property="Foreground" Value="White"/>
		<Setter Property="FontSize" Value="15"/>
		<Setter Property="FontWeight" Value="Bold"/>
		<Setter Property="FontStyle" Value="Italic"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
	</Style>

</ResourceDictionary>