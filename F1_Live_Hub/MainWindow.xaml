<Window x:Class="F1_Live_Hub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="F1 Live Hub"
        Height="900" Width="420"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize">

    <Border CornerRadius="28" ClipToBounds="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#000000" Offset="0"/>
                <!-- Very subtle red tint in the corner -->
                <GradientStop Color="#110000" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid>

            <!-- PAGE (dessous, invisible au départ) -->
            <Frame x:Name="AppFrame"
                   Opacity="0"
                   NavigationUIVisibility="Hidden"
                   Panel.ZIndex="0"/>

            <!-- SPLASH (dessus) -->
            <Grid x:Name="SplashGrid" Panel.ZIndex="10">

                <!-- Fond noir -->
                <Rectangle Fill="#0D0D0D"/>

                <!-- Lueur rouge centrale -->
                <Ellipse x:Name="SplashGlow"
                         Width="500" Height="500"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Opacity="0">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#66E50000" Offset="0"/>
                            <GradientStop Color="#22CC0000" Offset="0.4"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- Grille circuit -->
                <Rectangle x:Name="SplashGrid2" Opacity="0">
                    <Rectangle.Fill>
                        <DrawingBrush TileMode="Tile"
                                      Viewport="0,0,40,40"
                                      ViewportUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <GeometryDrawing Brush="Transparent">
                                    <GeometryDrawing.Pen>
                                        <Pen Brush="#22FF0000" Thickness="0.5"/>
                                    </GeometryDrawing.Pen>
                                    <GeometryDrawing.Geometry>
                                        <GeometryGroup>
                                            <LineGeometry StartPoint="0,0" EndPoint="40,0"/>
                                            <LineGeometry StartPoint="0,0" EndPoint="0,40"/>
                                        </GeometryGroup>
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- Vignette bords -->
                <Rectangle>
                    <Rectangle.Fill>
                        <RadialGradientBrush GradientOrigin="0.5,0.5"
                                             Center="0.5,0.5"
                                             RadiusX="0.65" RadiusY="0.65">
                            <GradientStop Color="Transparent" Offset="0.3"/>
                            <GradientStop Color="#CC0D0D0D"   Offset="1.0"/>
                        </RadialGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- Ligne rouge haut -->
                <Rectangle x:Name="SplashLineTop"
                           VerticalAlignment="Top"
                           Height="3" Width="0"
                           HorizontalAlignment="Center"
                           Margin="0,80,0,0">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="Transparent" Offset="0"/>
                            <GradientStop Color="#E50000"     Offset="0.5"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- Ligne rouge bas -->
                <Rectangle x:Name="SplashLineBottom"
                           VerticalAlignment="Bottom"
                           Height="3" Width="0"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,80">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="Transparent" Offset="0"/>
                            <GradientStop Color="#E50000"     Offset="0.5"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- LOGO GROUP -->
                <StackPanel x:Name="SplashLogoGroup"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Opacity="0">
                    <StackPanel.RenderTransformOrigin>0.5,0.5</StackPanel.RenderTransformOrigin>
                    <StackPanel.RenderTransform>
                        <ScaleTransform x:Name="SplashLogoScale"
                                        ScaleX="0.6" ScaleY="0.6"/>
                    </StackPanel.RenderTransform>

                    <!-- Badge F1 -->
                    <Border HorizontalAlignment="Center"
                            CornerRadius="6" Padding="22,10"
                            Margin="0,0,0,18">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#E50000" Offset="0"/>
                                <GradientStop Color="#AA0000" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect x:Name="SplashLogoGlow"
                                              Color="#FF0000"
                                              BlurRadius="0"
                                              ShadowDepth="0"
                                              Opacity="0.9"/>
                        </Border.Effect>
                        <TextBlock Text="F1"
                                   Foreground="White"
                                   FontSize="72"
                                   FontWeight="Black"
                                   FontFamily="Impact"/>
                    </Border>

                    <!-- HUB -->
                    <TextBlock x:Name="SplashHubText"
                               Text="HUB"
                               Foreground="White"
                               FontSize="28"
                               FontWeight="Black"
                               FontFamily="Impact"
                               HorizontalAlignment="Center"
                               Opacity="0">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#FF0000" BlurRadius="10"
                                              ShadowDepth="0" Opacity="0.5"/>
                        </TextBlock.Effect>
                    </TextBlock>

                    <!-- Sous-ligne -->
                    <Rectangle x:Name="SplashSubLine"
                               Height="2" Width="0"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="Transparent" Offset="0"/>
                                <GradientStop Color="#E50000"     Offset="0.5"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- Tagline -->
                    <TextBlock x:Name="SplashTagline"
                               Text="REAL-TIME · RACING · DATA"
                               Foreground="#555555"
                               FontSize="9"
                               FontFamily="Consolas"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0"
                               Opacity="0"/>
                </StackPanel>

                <!-- Barre de chargement -->
                <StackPanel VerticalAlignment="Bottom"
                            HorizontalAlignment="Center"
                            Width="200"
                            Margin="0,0,0,60">
                    <Border CornerRadius="4" Height="3"
                            Background="#1AFFFFFF"
                            ClipToBounds="True">
                        <Rectangle x:Name="SplashLoadBar"
                                   Width="0" Height="3"
                                   HorizontalAlignment="Left">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#E50000" Offset="0"/>
                                    <GradientStop Color="#FF4444" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                            <Rectangle.Effect>
                                <DropShadowEffect Color="#FF0000" BlurRadius="6"
                                                  ShadowDepth="0" Opacity="0.8"/>
                            </Rectangle.Effect>
                        </Rectangle>
                    </Border>
                    <TextBlock x:Name="SplashLoadText"
                               Text="CHARGEMENT..."
                               Foreground="#333333"
                               FontSize="8"
                               FontFamily="Consolas"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"
                               Opacity="0"/>
                </StackPanel>

                <!-- Flash blanc final -->
                <Rectangle x:Name="SplashFlash"
                           Fill="White"
                           Opacity="0"
                           IsHitTestVisible="False"/>

            </Grid>

            <!-- Drag zone -->
            <Rectangle VerticalAlignment="Top"
                       Height="60"
                       Fill="Transparent"
                       Panel.ZIndex="99"
                       MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"/>

            <!-- Bouton fermer -->
            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Width="28" Height="28"
                    CornerRadius="14"
                    Background="#15FFFFFF"
                    Margin="0,10,10,0"
                    Cursor="Hand"
                    Panel.ZIndex="99">
                <TextBlock Text="✕"
                           Foreground="#555555"
                           FontSize="9"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           MouseLeftButtonDown="CloseButton_Click"/>
            </Border>

        </Grid>
    </Border>
</Window>