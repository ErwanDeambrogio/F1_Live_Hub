<Window x:Class="test.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:test"
        mc:Ignorable="d"
        Title="Belgian GP - Météo" Height="850" Width="400"
        Background="#0D0D0D">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentRed" Color="#E8002D"/>
        <SolidColorBrush x:Key="AccentOrange" Color="#FF6B00"/>
        <SolidColorBrush x:Key="TealAccent" Color="#00BCD4"/>
        <SolidColorBrush x:Key="GreenAccent" Color="#4CAF50"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#8A8A8A"/>
        <SolidColorBrush x:Key="TextMuted" Color="#5A5A5A"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <Style x:Key="LabelCap" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A8A8A"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="LabelBig" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="34"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Background="#0D0D0D">
            <StackPanel Margin="12,0,12,12">

                <!-- HEADER -->
                <Grid Margin="0,14,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="☰" Foreground="White"
                               FontSize="22" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="BELGIAN GRAND PRIX" Foreground="White"
                                   FontSize="13" FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="LIVE TRACKING" Foreground="#E8002D"
                                   FontSize="9" FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="🔔" Foreground="White"
                               FontSize="20" VerticalAlignment="Center"/>
                </Grid>

                <!-- TABS -->
                <Grid Margin="0,4,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="STATS" Foreground="#5A5A5A"
                               FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Height="20" VerticalAlignment="Top"/>
                    <TextBlock Grid.Column="1" Text="PILOTES" Foreground="#5A5A5A"
                               FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="COURSE" Foreground="#5A5A5A"
                               FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                        <TextBlock Text="MÉTÉO" Foreground="#E8002D"
                                   FontSize="11" FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                        <Border Background="#E8002D" Height="2" Width="40"
                                CornerRadius="1" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- ALERT BANNER -->
                <Border Background="#1E0000" BorderBrush="#E8002D"
                        BorderThickness="1" CornerRadius="6"
                        Padding="10,8" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="⚠" Foreground="#E8002D"
                                   FontSize="18" VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="DRS DÉSACTIVÉ – PLUIE"
                                       Foreground="#E8002D" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="Précipitations fortes détectées dans le Secteur 2 (Eau Rouge)."
                                       Foreground="#FFAAAA" FontSize="10" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Border Grid.Column="2" Background="#E8002D" CornerRadius="4"
                                Padding="8,5" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock Text="DÉTAILS" Foreground="White"
                                       FontSize="9" FontWeight="Bold"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- MAP -->
                <Border Style="{StaticResource Card}" Padding="0"
                        Height="185" Margin="0,0,0,10">
                    <Grid ClipToBounds="True">
                        <Border Background="#1B2A1B" CornerRadius="8"/>
                        <TextBlock Text="Spa-Francorchamps" Foreground="#2A4A2A"
                                   FontSize="13" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Margin="0,-20,0,0"/>
                        <TextBlock Text="📍" FontSize="28"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Margin="10,10,0,0"/>
                        <Border Background="#33E8002D" BorderBrush="#E8002D"
                                BorderThickness="1" CornerRadius="4"
                                Padding="6,3" HorizontalAlignment="Left"
                                VerticalAlignment="Bottom" Margin="10,0,0,10">
                            <TextBlock Text="⚡ SECTEUR 2" Foreground="#E8002D"
                                       FontSize="9" FontWeight="Bold"/>
                        </Border>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Margin="0,0,8,0">
                            <Border Background="#1A1A1A" BorderBrush="#333333"
                                    BorderThickness="1" CornerRadius="4"
                                    Width="32" Height="32" Margin="0,0,0,4">
                                <TextBlock Text="+" Foreground="White" FontSize="16"
                                           FontWeight="Bold" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <Border Background="#1A1A1A" BorderBrush="#333333"
                                    BorderThickness="1" CornerRadius="4"
                                    Width="32" Height="32">
                                <TextBlock Text="–" Foreground="White" FontSize="16"
                                           FontWeight="Bold" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                        <Border Background="#00BCD4" CornerRadius="4" Padding="7"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Margin="0,0,8,8" Width="30" Height="30">
                            <TextBlock Text="⊞" Foreground="White" FontSize="14"
                                       FontWeight="Bold" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- TEMP AIR + TEMP PISTE -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="TEMP. AIR"
                                           Style="{StaticResource LabelCap}"/>
                                <TextBlock Grid.Column="1" Text="🌡" FontSize="14"
                                           Foreground="#8A8A8A"/>
                            </Grid>
                            <TextBlock Text="22°C" Style="{StaticResource LabelBig}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="↓ " Foreground="#E8002D"
                                           FontSize="12" FontWeight="Bold"/>
                                <TextBlock Text="-1.2°/h" Foreground="#E8002D"
                                           FontSize="11" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="TEMP. PISTE"
                                           Style="{StaticResource LabelCap}"/>
                                <TextBlock Grid.Column="1" Text="🌡" FontSize="14"
                                           Foreground="#8A8A8A"/>
                            </Grid>
                            <TextBlock Text="32°C" Style="{StaticResource LabelBig}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="↑ " Foreground="#4CAF50"
                                           FontSize="12" FontWeight="Bold"/>
                                <TextBlock Text="+3.5°/h" Foreground="#4CAF50"
                                           FontSize="11" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- HUMIDITY + WIND -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="HUMIDITÉ"
                                           Style="{StaticResource LabelCap}"/>
                                <TextBlock Grid.Column="1" Text="💧" FontSize="14"/>
                            </Grid>
                            <TextBlock Text="78%" Style="{StaticResource LabelBig}"/>
                            <Grid Height="5" Margin="0,8,0,0">
                                <Border Background="#2A2A2A" CornerRadius="3"/>
                                <Border Background="#00BCD4" CornerRadius="3"
                                        HorizontalAlignment="Left" Width="112"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="VENT"
                                           Style="{StaticResource LabelCap}"/>
                                <TextBlock Grid.Column="1" Text="💨" FontSize="14"/>
                            </Grid>
                            <TextBlock Text="14 km/h NW" Foreground="White"
                                       FontSize="19" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock Text="Rafales 32 km/h" Foreground="#8A8A8A"
                                       FontSize="11" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- RAIN PROBABILITY CHART -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="PROBABILITÉ DE PLUIE (60M)"
                                       Style="{StaticResource LabelCap}" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="#2A1500"
                                    BorderBrush="#FF6B00" BorderThickness="1"
                                    CornerRadius="4" Padding="6,3">
                                <TextBlock Text="Alerte Orange" Foreground="#FF6B00"
                                           FontSize="10" FontWeight="Bold"/>
                            </Border>
                        </Grid>

                        <Grid Height="96">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#E8002D" CornerRadius="3"
                                    VerticalAlignment="Bottom" Height="76" Margin="2,0"/>
                            <Border Grid.Column="1" Background="#E8002D" CornerRadius="3"
                                    VerticalAlignment="Bottom" Height="62" Margin="2,0"/>
                            <Border Grid.Column="2" Background="#CC1122" CornerRadius="3"
                                    VerticalAlignment="Bottom" Height="52" Margin="2,0"/>
                            <Border Grid.Column="3" Background="#AA1111" CornerRadius="3"
                                    VerticalAlignment="Bottom" Height="44" Margin="2,0"/>
                            <Border Grid.Column="4" Background="#881100" CornerRadius="3"
                                    VerticalAlignment="Bottom" Height="30" Margin="2,0"/>
                            <Border Grid.Column="5" Background="#00BCD4" CornerRadius="3"
                                    VerticalAlignment="Bottom" Height="18" Margin="2,0"/>
                            <Border Grid.Column="6" Background="#00BCD4" CornerRadius="3"
                                    VerticalAlignment="Bottom" Height="34" Margin="2,0"/>
                            <Border Grid.Column="7" Background="#00BCD4" CornerRadius="3"
                                    VerticalAlignment="Bottom" Height="56" Margin="2,0"/>
                            <Border Grid.Column="8" Background="#00BCD4" CornerRadius="3"
                                    VerticalAlignment="Bottom" Height="68" Margin="2,0"/>
                            <Border Grid.Column="9" Background="#00BCD4" CornerRadius="3"
                                    VerticalAlignment="Bottom" Height="50" Margin="2,0"/>
                        </Grid>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="MAIN." Foreground="#5A5A5A"
                                       FontSize="7" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="+30M" Foreground="#5A5A5A"
                                       FontSize="7" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="9" Text="+60M" Foreground="#5A5A5A"
                                       FontSize="7" HorizontalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- AUDIO PLAYER -->
                <Border Style="{StaticResource Card}" Padding="12,10">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="▶" Foreground="White"
                                   FontSize="18" VerticalAlignment="Center"/>
                        <Grid Grid.Column="1" Margin="14,0" VerticalAlignment="Center" Height="13">
                            <Border Background="#333333" Height="3"
                                    VerticalAlignment="Center" CornerRadius="2"/>
                            <Border Background="#E8002D" Height="3"
                                    VerticalAlignment="Center" HorizontalAlignment="Left"
                                    Width="85" CornerRadius="2"/>
                            <Ellipse Fill="#E8002D" Width="13" Height="13"
                                     HorizontalAlignment="Left" Margin="78,0,0,0"/>
                        </Grid>
                        <TextBlock Grid.Column="2" Text="14:24" Foreground="#8A8A8A"
                                   FontSize="12" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- BOTTOM NAV -->
        <Border Grid.Row="1" Background="#111111" Padding="0,10,0,14"
                BorderBrush="#2A2A2A" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="🏠" FontSize="20" HorizontalAlignment="Center"/>
                    <TextBlock Text="Home" Foreground="#5A5A5A"
                               FontSize="9" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="⏱" FontSize="20" HorizontalAlignment="Center"/>
                    <TextBlock Text="Timing" Foreground="#5A5A5A"
                               FontSize="9" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <Border Background="#E8002D" CornerRadius="30"
                            Padding="14,10" HorizontalAlignment="Center"
                            Margin="0,-22,0,0">
                        <TextBlock Text="☁" FontSize="22"/>
                    </Border>
                    <TextBlock Text="Météo" Foreground="#E8002D"
                               FontSize="9" HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                    <TextBlock Text="🏎" FontSize="20" HorizontalAlignment="Center"/>
                    <TextBlock Text="Track" Foreground="#5A5A5A"
                               FontSize="9" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                    <TextBlock Text="👤" FontSize="20" HorizontalAlignment="Center"/>
                    <TextBlock Text="Profil" Foreground="#5A5A5A"
                               FontSize="9" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>