<Window x:Class="F1_Live_Hub.Views.ConstructorPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        WindowStyle="None" AllowsTransparency="True"
        ResizeMode="NoResize"
        Title="F1 Live Hub - Constructeurs" Height="900" Width="420"
        Background="#0D0D0D" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style x:Key="TabBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#606060"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="0,10">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ═══ -->
        <Border Grid.Row="0" Background="#0F0F0F"
                BorderBrush="#1E1E1E" BorderThickness="0,0,0,1"
                Padding="16,14" MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="8" Width="32" Height="32" Margin="0,0,10,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF0028" Offset="0"/>
                                <GradientStop Color="#CC0020" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="F1" Foreground="White" FontSize="12"
                                   FontWeight="Bold" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock VerticalAlignment="Center">
                        <Run Text="F1 " Foreground="White" FontSize="19" FontWeight="Bold"/>
                        <Run Text="LIVE " Foreground="#E8002D" FontSize="19" FontWeight="Bold"/>
                        <Run Text="HUB" Foreground="#888888" FontSize="19" FontWeight="Bold"/>
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1C1C1C" CornerRadius="20"
                            Width="36" Height="36" Cursor="Hand" Margin="0,0,8,0">
                        <TextBlock Text="🔍" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Button Width="36" Height="36" Style="{StaticResource NavBtn}"
                            Click="ProfilButton_Click">
                        <Border Background="#252525" CornerRadius="20" Width="36" Height="36">
                            <TextBlock Text="👤" FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Bottom" Margin="0,0,0,7"/>
                        </Border>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ TABS ═══ -->
        <Border Grid.Row="1" Background="#0F0F0F"
                BorderBrush="#1E1E1E" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource TabBtn}"
                        Content="ACCUEIL" Click="Tab_Accueil_Click"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="CLASSEMENT" Foreground="White"
                               FontSize="10" FontWeight="Bold"
                               HorizontalAlignment="Center" Padding="0,11,0,8"/>
                    <Border Height="2" CornerRadius="1" Background="#E8002D"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource TabBtn}"
                        Content="PILOTES" Click="Tab_Pilotes_Click"/>
                <Button Grid.Column="3" Style="{StaticResource TabBtn}"
                        Content="COURSE" Click="Tab_Course_Click"/>
            </Grid>
        </Border>

        <!-- ═══ HEADER COLONNES ═══ -->
        <Border Grid.Row="2" Background="#0A0A0A">
            <Grid Margin="22,6,12,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="POS" Foreground="#5A5A5A"
                           FontSize="9" FontWeight="Bold"/>
                <TextBlock Grid.Column="2" Text="CONSTRUCTEUR" Foreground="#5A5A5A"
                           FontSize="9" FontWeight="Bold" Margin="4,0,0,0"/>
                <TextBlock Grid.Column="3" Text="PTS" Foreground="#5A5A5A"
                           FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="4" Text="VICTOIRES" Foreground="#5A5A5A"
                           FontSize="9" FontWeight="Bold" HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- ═══ LISTE CONSTRUCTEURS DYNAMIQUE ═══ -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Background="#0D0D0D">
            <ItemsControl x:Name="ListeConstructeurs" Margin="12,8,12,12">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,6,0,0">
                            <Grid Margin="0,0,12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="38"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{Binding CouleurEquipe}"
                                        Width="3" CornerRadius="2"
                                        HorizontalAlignment="Left" Margin="0,8,0,8"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Position}"
                                           Foreground="{Binding CouleurPosition}"
                                           FontSize="18" FontWeight="Bold" FontStyle="Italic"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                           Margin="0,12,0,12"/>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                            Margin="8,12,0,12">
                                    <TextBlock Text="{Binding NomEquipe}"
                                               Foreground="White" FontSize="12" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Ecart}"
                                               Foreground="{Binding CouleurEcart}"
                                               FontSize="10" Margin="0,2,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="3"
                                           Text="{Binding Points}"
                                           Foreground="White" FontSize="14" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Margin="0,12,0,12"/>
                                <TextBlock Grid.Column="4"
                                           Text="{Binding Victoires}"
                                           Foreground="#8A8A8A" FontSize="12" FontWeight="Bold"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Margin="0,12,0,12"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ═══ BOTTOM NAV ═══ -->
        <Border Grid.Row="4" Background="#0F0F0F"
                BorderBrush="#1E1E1E" BorderThickness="0,1,0,0"
                Padding="0,10,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource NavBtn}" Click="Nav_Accueil_Click">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🏠" FontSize="20" HorizontalAlignment="Center"/>
                        <TextBlock Text="ACCUEIL" Foreground="White" FontSize="7"
                                   FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Style="{StaticResource NavBtn}" Click="Nav_Live_Click">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📡" FontSize="20" HorizontalAlignment="Center"/>
                        <TextBlock Text="LIVE" Foreground="White" FontSize="7"
                                   FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Button>
                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="📊" FontSize="20" HorizontalAlignment="Center"/>
                    <TextBlock Text="STATS" Foreground="#E8002D" FontSize="7"
                               FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    <Border Height="2" Width="20" CornerRadius="1"
                            Background="#E8002D" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="3" Style="{StaticResource NavBtn}" Click="Nav_Course_Click">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🏎" FontSize="20" HorizontalAlignment="Center"/>
                        <TextBlock Text="COURSES" Foreground="White" FontSize="7"
                                   FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="4" Style="{StaticResource NavBtn}" Click="Nav_Profil_Click">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="👤" FontSize="20" HorizontalAlignment="Center"/>
                        <TextBlock Text="PROFIL" Foreground="White" FontSize="7"
                                   FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

    </Grid>
</Window>