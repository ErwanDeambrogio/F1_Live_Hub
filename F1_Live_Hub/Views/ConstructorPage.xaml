<Window x:Class="F1_Live_Hub.Views.ConstructorPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:F1_Live_Hub.Views"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Title="F1 Live Hub - Constructeurs" Height="900" Width="420"
        Background="#0D0D0D" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#111111"
                BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
            <Grid Margin="14,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#E8002D" CornerRadius="6" Width="26" Height="26">
                        <TextBlock Text="F1" Foreground="White" FontSize="10"
                                   FontWeight="Bold" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock VerticalAlignment="Center" Margin="8,0,0,0">
                        <Run Text="F1 " Foreground="White" FontSize="17" FontWeight="Bold"/>
                        <Run Text="LIVE " Foreground="#E8002D" FontSize="17" FontWeight="Bold"/>
                        <Run Text="HUB" Foreground="White" FontSize="17" FontWeight="Bold"/>
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Border Background="#1A1A1A" CornerRadius="20"
                            Width="34" Height="34" Margin="0,0,8,0">
                        <TextBlock Text="🔔" FontSize="14"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <Border Background="#2A2A2A" CornerRadius="20" Width="34" Height="34">
                        <TextBlock Text="👤" FontSize="14"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- TABS -->
        <Border Grid.Row="1" Background="#111111"
                BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <TextBlock Text="Pilotes" Foreground="#5A5A5A" FontSize="12"
                               FontWeight="Bold" HorizontalAlignment="Center"
                               Margin="0,10" Cursor="Hand"
                               MouseLeftButtonDown="Tab_Pilotes_Click"/>
                </StackPanel>

                <!-- Constructeurs actif -->
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Constructeurs" Foreground="White" FontSize="12"
                               FontWeight="Bold" HorizontalAlignment="Center"
                               Margin="0,10"/>
                    <Border Background="#E8002D" Height="2" CornerRadius="1"/>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <TextBlock Text="Historique" Foreground="#5A5A5A" FontSize="12"
                               FontWeight="Bold" HorizontalAlignment="Center"
                               Margin="0,10" Cursor="Hand"
                               MouseLeftButtonDown="Tab_Historique_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- SAISON + PODIUM TOP 3 -->
        <Border Grid.Row="2" Background="#111111"
                BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
            <StackPanel Margin="14,10">

                <!-- Saison selector -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Border Background="#1A1A1A" BorderBrush="#333333"
                            BorderThickness="1" CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Margin="10,5">
                            <TextBlock Text="2024" Foreground="White"
                                       FontSize="12" FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text=" ▾" Foreground="#8A8A8A"
                                       FontSize="10" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#E8002D" CornerRadius="6"
                            Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal" Margin="10,5">
                            <Ellipse Fill="White" Width="6" Height="6"
                                     VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="EN COURS" Foreground="White"
                                       FontSize="10" FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Podium TOP 3 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- P2 McLaren -->
                    <Border Grid.Column="0" Background="#1A1A1A"
                            BorderBrush="#2A2A2A" BorderThickness="1"
                            CornerRadius="8" Margin="0,16,4,0">
                        <StackPanel HorizontalAlignment="Center" Margin="8,10">
                            <Border Background="#FF8000" CornerRadius="20"
                                    Width="40" Height="40"
                                    HorizontalAlignment="Center" Margin="0,0,0,6">
                                <TextBlock Text="2" Foreground="White" FontSize="18"
                                           FontWeight="Bold" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="McLaren" Foreground="White" FontSize="11"
                                       FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="516 pts" Foreground="#FF8000"
                                       FontSize="13" FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- P1 Red Bull -->
                    <Border Grid.Column="1" Background="#1A1A1A"
                            BorderBrush="#E8002D" BorderThickness="1"
                            CornerRadius="8" Margin="4,0">
                        <StackPanel HorizontalAlignment="Center" Margin="8,10">
                            <Border Background="#E8002D" CornerRadius="20"
                                    Width="48" Height="48"
                                    HorizontalAlignment="Center" Margin="0,0,0,6">
                                <TextBlock Text="1" Foreground="White" FontSize="22"
                                           FontWeight="Bold" FontStyle="Italic"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Red Bull" Foreground="White" FontSize="11"
                                       FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="860 pts" Foreground="#E8002D"
                                       FontSize="13" FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                            <Border Background="#E8002D" CornerRadius="4"
                                    HorizontalAlignment="Center" Margin="0,4,0,0">
                                <TextBlock Text="🏆 LEADER" Foreground="White"
                                           FontSize="8" FontWeight="Bold" Margin="5,2"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- P3 Ferrari -->
                    <Border Grid.Column="2" Background="#1A1A1A"
                            BorderBrush="#2A2A2A" BorderThickness="1"
                            CornerRadius="8" Margin="4,16,0,0">
                        <StackPanel HorizontalAlignment="Center" Margin="8,10">
                            <Border Background="#E8002D" CornerRadius="20"
                                    Width="40" Height="40"
                                    HorizontalAlignment="Center" Margin="0,0,0,6">
                                <TextBlock Text="3" Foreground="White" FontSize="18"
                                           FontWeight="Bold" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Ferrari" Foreground="White" FontSize="11"
                                       FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="515 pts" Foreground="#E8002D"
                                       FontSize="13" FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                </Grid>
            </StackPanel>
        </Border>

        <!-- LISTE CONSTRUCTEURS -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"
                      Background="#0D0D0D">
            <StackPanel Margin="12,8,12,12">

                <!-- Header colonnes -->
                <Grid Margin="10,0,10,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="POS" Foreground="#5A5A5A"
                               FontSize="9" FontWeight="Bold"/>
                    <TextBlock Grid.Column="2" Text="CONSTRUCTEUR"
                               Foreground="#5A5A5A" FontSize="9"
                               FontWeight="Bold" Margin="6,0,0,0"/>
                    <TextBlock Grid.Column="3" Text="PTS" Foreground="#5A5A5A"
                               FontSize="9" FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="VICTOIRES"
                               Foreground="#5A5A5A" FontSize="9"
                               FontWeight="Bold" HorizontalAlignment="Right"/>
                </Grid>

                <!-- P1 Red Bull -->
                <Border Style="{StaticResource Card}" Margin="0,4,0,0">
                    <Grid Margin="0,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="38"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#3B6FE8" Width="3"
                                CornerRadius="2" HorizontalAlignment="Left"
                                Margin="0,8,0,8"/>
                        <TextBlock Grid.Column="1" Text="01" Foreground="#E8002D"
                                   FontSize="18" FontWeight="Bold" FontStyle="Italic"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                   Margin="0,12,0,12"/>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                    Margin="8,12,0,12">
                            <TextBlock Text="RED BULL RACING" Foreground="White"
                                       FontSize="12" FontWeight="Bold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="VER" Foreground="#8A8A8A" FontSize="9"/>
                                <TextBlock Text=" · " Foreground="#5A5A5A" FontSize="9"/>
                                <TextBlock Text="PER" Foreground="#8A8A8A" FontSize="9"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="3" HorizontalAlignment="Center"
                                    VerticalAlignment="Center" Margin="0,12,0,12">
                            <TextBlock Text="860" Foreground="White" FontSize="14"
                                       FontWeight="Bold" HorizontalAlignment="Center"/>
                            <Border Background="#2A2A2A" Height="3" Width="44"
                                    CornerRadius="2" Margin="0,3,0,0">
                                <Border Background="#3B6FE8" Height="3" Width="44"
                                        CornerRadius="2" HorizontalAlignment="Left"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Grid.Column="4" Text="9 🏆" Foreground="#E8002D"
                                   FontSize="12" FontWeight="Bold"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Margin="0,12,0,12"/>
                    </Grid>
                </Border>

                <!-- P2 McLaren -->
                <Border Style="{StaticResource Card}" Margin="0,6,0,0">
                    <Grid Margin="0,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="38"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#FF8000" Width="3"
                                CornerRadius="2" HorizontalAlignment="Left"
                                Margin="0,8,0,8"/>
                        <TextBlock Grid.Column="1" Text="02" Foreground="#8A8A8A"
                                   FontSize="16" FontWeight="Bold" FontStyle="Italic"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                   Margin="0,12,0,12"/>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                    Margin="8,12,0,12">
                            <TextBlock Text="McLAREN F1" Foreground="White"
                                       FontSize="12" FontWeight="Bold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="NOR" Foreground="#8A8A8A" FontSize="9"/>
                                <TextBlock Text=" · " Foreground="#5A5A5A" FontSize="9"/>
                                <TextBlock Text="PIA" Foreground="#8A8A8A" FontSize="9"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="3" HorizontalAlignment="Center"
                                    VerticalAlignment="Center" Margin="0,12,0,12">
                            <TextBlock Text="516" Foreground="White" FontSize="14"
                                       FontWeight="Bold" HorizontalAlignment="Center"/>
                            <Border Background="#2A2A2A" Height="3" Width="44"
                                    CornerRadius="2" Margin="0,3,0,0">
                                <Border Background="#FF8000" Height="3" Width="27"
                                        CornerRadius="2" HorizontalAlignment="Left"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Grid.Column="4" Text="3 🏆" Foreground="#8A8A8A"
                                   FontSize="12" FontWeight="Bold"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Margin="0,12,0,12"/>
                    </Grid>
                </Border>

                <!-- P3 Ferrari -->
                <Border Style="{StaticResource Card}" Margin="0,6,0,0">
                    <Grid Margin="0,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="38"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#E8002D" Width="3"
                                CornerRadius="2" HorizontalAlignment="Left"
                                Margin="0,8,0,8"/>
                        <TextBlock Grid.Column="1" Text="03" Foreground="#8A8A8A"
                                   FontSize="16" FontWeight="Bold" FontStyle="Italic"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                   Margin="0,12,0,12"/>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                    Margin="8,12,0,12">
                            <TextBlock Text="SCUDERIA FERRARI" Foreground="White"
                                       FontSize="12" FontWeight="Bold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="LEC" Foreground="#8A8A8A" FontSize="9"/>
                                <TextBlock Text=" · " Foreground="#5A5A5A" FontSize="9"/>
                                <TextBlock Text="SAI" Foreground="#8A8A8A" FontSize="9"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="3" HorizontalAlignment="Center"
                                    VerticalAlignment="Center" Margin="0,12,0,12">
                            <TextBlock Text="515" Foreground="White" FontSize="14"
                                       FontWeight="Bold" HorizontalAlignment="Center"/>
                            <Border Background="#2A2A2A" Height="3" Width="44"
                                    CornerRadius="2" Margin="0,3,0,0">
                                <Border Background="#E8002D" Height="3" Width="26"
                                        CornerRadius="2" HorizontalAlignment="Left"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Grid.Column="4" Text="2 🏆" Foreground="#8A8A8A"
                                   FontSize="12" FontWeight="Bold"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Margin="0,12,0,12"/>
                    </Grid>
                </Border>

                <!-- P4 Mercedes -->
                <Border Style="{StaticResource Card}" Margin="0,6,0,0">
                    <Grid Margin="0,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="38"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#00D2BE" Width="3"
                                CornerRadius="2" HorizontalAlignment="Left"
                                Margin="0,8,0,8"/>
                        <TextBlock Grid.Column="1" Text="04" Foreground="#8A8A8A"
                                   FontSize="16" FontWeight="Bold" FontStyle="Italic"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                   Margin="0,12,0,12"/>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                    Margin="8,12,0,12">
                            <TextBlock Text="MERCEDES-AMG" Foreground="White"
                                       FontSize="12" FontWeight="Bold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="HAM" Foreground="#8A8A8A" FontSize="9"/>
                                <TextBlock Text=" · " Foreground="#5A5A5A" FontSize="9"/>
                                <TextBlock Text="RUS" Foreground="#8A8A8A" FontSize="9"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="3" HorizontalAlignment="Center"
                                    VerticalAlignment="Center" Margin="0,12,0,12">
                            <TextBlock Text="407" Foreground="White" FontSize="14"
                                       FontWeight="Bold" HorizontalAlignment="Center"/>
                            <Border Background="#2A2A2A" Height="3" Width="44"
                                    CornerRadius="2" Margin="0,3,0,0">
                                <Border Background="#00D2BE" Height="3" Width="20"
                                        CornerRadius="2" HorizontalAlignment="Left"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Grid.Column="4" Text="0 🏆" Foreground="#8A8A8A"
                                   FontSize="12" FontWeight="Bold"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Margin="0,12,0,12"/>
                    </Grid>
                </Border>

                <!-- P5 Aston Martin -->
                <Border Style="{StaticResource Card}" Margin="0,6,0,0">
                    <Grid Margin="0,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="38"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#358C75" Width="3"
                                CornerRadius="2" HorizontalAlignment="Left"
                                Margin="0,8,0,8"/>
                        <TextBlock Grid.Column="1" Text="05" Foreground="#8A8A8A"
                                   FontSize="16" FontWeight="Bold" FontStyle="Italic"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                   Margin="0,12,0,12"/>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                    Margin="8,12,0,12">
                            <TextBlock Text="ASTON MARTIN" Foreground="White"
                                       FontSize="12" FontWeight="Bold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="ALO" Foreground="#8A8A8A" FontSize="9"/>
                                <TextBlock Text=" · " Foreground="#5A5A5A" FontSize="9"/>
                                <TextBlock Text="STR" Foreground="#8A8A8A" FontSize="9"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="3" HorizontalAlignment="Center"
                                    VerticalAlignment="Center" Margin="0,12,0,12">
                            <TextBlock Text="236" Foreground="White" FontSize="14"
                                       FontWeight="Bold" HorizontalAlignment="Center"/>
                            <Border Background="#2A2A2A" Height="3" Width="44"
                                    CornerRadius="2" Margin="0,3,0,0">
                                <Border Background="#358C75" Height="3" Width="12"
                                        CornerRadius="2" HorizontalAlignment="Left"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Grid.Column="4" Text="0 🏆" Foreground="#8A8A8A"
                                   FontSize="12" FontWeight="Bold"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Margin="0,12,0,12"/>
                    </Grid>
                </Border>

                <!-- P6 Alpine -->
                <Border Style="{StaticResource Card}" Margin="0,6,0,0">
                    <Grid Margin="0,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="38"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#0078FF" Width="3"
                                CornerRadius="2" HorizontalAlignment="Left"
                                Margin="0,8,0,8"/>
                        <TextBlock Grid.Column="1" Text="06" Foreground="#8A8A8A"
                                   FontSize="16" FontWeight="Bold" FontStyle="Italic"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                   Margin="0,12,0,12"/>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                    Margin="8,12,0,12">
                            <TextBlock Text="ALPINE F1" Foreground="White"
                                       FontSize="12" FontWeight="Bold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="GAS" Foreground="#8A8A8A" FontSize="9"/>
                                <TextBlock Text=" · " Foreground="#5A5A5A" FontSize="9"/>
                                <TextBlock Text="OCO" Foreground="#8A8A8A" FontSize="9"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="3" HorizontalAlignment="Center"
                                    VerticalAlignment="Center" Margin="0,12,0,12">
                            <TextBlock Text="120" Foreground="White" FontSize="14"
                                       FontWeight="Bold" HorizontalAlignment="Center"/>
                            <Border Background="#2A2A2A" Height="3" Width="44"
                                    CornerRadius="2" Margin="0,3,0,0">
                                <Border Background="#0078FF" Height="3" Width="6"
                                        CornerRadius="2" HorizontalAlignment="Left"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Grid.Column="4" Text="0 🏆" Foreground="#8A8A8A"
                                   FontSize="12" FontWeight="Bold"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Margin="0,12,0,12"/>
                    </Grid>
                </Border>

                <!-- P7 Williams -->
                <Border Style="{StaticResource Card}" Margin="0,6,0,0">
                    <Grid Margin="0,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="38"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#005AFF" Width="3"
                                CornerRadius="2" HorizontalAlignment="Left"
                                Margin="0,8,0,8"/>
                        <TextBlock Grid.Column="1" Text="07" Foreground="#8A8A8A"
                                   FontSize="16" FontWeight="Bold" FontStyle="Italic"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                   Margin="0,12,0,12"/>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                    Margin="8,12,0,12">
                            <TextBlock Text="WILLIAMS" Foreground="White"
                                       FontSize="12" FontWeight="Bold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="ALB" Foreground="#8A8A8A" FontSize="9"/>
                                <TextBlock Text=" · " Foreground="#5A5A5A" FontSize="9"/>
                                <TextBlock Text="SAR" Foreground="#8A8A8A" FontSize="9"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="3" HorizontalAlignment="Center"
                                    VerticalAlignment="Center" Margin="0,12,0,12">
                            <TextBlock Text="43" Foreground="White" FontSize="14"
                                       FontWeight="Bold" HorizontalAlignment="Center"/>
                            <Border Background="#2A2A2A" Height="3" Width="44"
                                    CornerRadius="2" Margin="0,3,0,0">
                                <Border Background="#005AFF" Height="3" Width="3"
                                        CornerRadius="2" HorizontalAlignment="Left"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Grid.Column="4" Text="0 🏆" Foreground="#8A8A8A"
                                   FontSize="12" FontWeight="Bold"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Margin="0,12,0,12"/>
                    </Grid>
                </Border>

                <!-- P8 RB Honda -->
                <Border Style="{StaticResource Card}" Margin="0,6,0,0">
                    <Grid Margin="0,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="38"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#1E3A6E" Width="3"
                                CornerRadius="2" HorizontalAlignment="Left"
                                Margin="0,8,0,8"/>
                        <TextBlock Grid.Column="1" Text="08" Foreground="#8A8A8A"
                                   FontSize="16" FontWeight="Bold" FontStyle="Italic"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                   Margin="0,12,0,12"/>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                    Margin="8,12,0,12">
