<Window x:Class="F1_Live_Hub.Views.LivePage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Title="F1 Live Hub - Live" Height="900" Width="420"
        Background="#0A0A0A" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style x:Key="TabBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#606060"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="0,10">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ═══ -->
        <Border Grid.Row="0" Background="#0F0F0F"
                BorderBrush="#1E1E1E" BorderThickness="0,0,0,1"
                Padding="16,14"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="8" Width="32" Height="32" Margin="0,0,10,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF0028" Offset="0"/>
                                <GradientStop Color="#CC0020" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="F1" Foreground="White" FontSize="12"
                                   FontWeight="Bold" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock VerticalAlignment="Center">
                        <Run Text="F1 " Foreground="White" FontSize="19" FontWeight="Bold"/>
                        <Run Text="LIVE " Foreground="#E8002D" FontSize="19" FontWeight="Bold"/>
                        <Run Text="HUB" Foreground="#888888" FontSize="19" FontWeight="Bold"/>
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1C1C1C" CornerRadius="20"
                            Width="36" Height="36" Cursor="Hand" Margin="0,0,8,0">
                        <TextBlock Text="🔍" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Button Width="36" Height="36" Style="{StaticResource NavBtn}"
                            Click="Nav_Profil_Click">
                        <Border Background="#252525" CornerRadius="20" Width="36" Height="36">
                            <TextBlock Text="👤" FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Bottom" Margin="0,0,0,7"/>
                        </Border>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ TABS ═══ -->
        <Border Grid.Row="1" Background="#0F0F0F"
                BorderBrush="#1E1E1E" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource TabBtn}"
                        Content="ACCUEIL" Click="Tab_Accueil_Click"/>
                <Button Grid.Column="1" Style="{StaticResource TabBtn}"
                        Content="CLASSEMENT" Click="Tab_Classement_Click"/>
                <Button Grid.Column="2" Style="{StaticResource TabBtn}"
                        Content="PILOTES" Click="Tab_Pilotes_Click"/>

                <!-- LIVE actif -->
                <StackPanel Grid.Column="3">
                    <TextBlock Text="LIVE" Foreground="White" FontSize="10"
                               FontWeight="Bold" HorizontalAlignment="Center"
                               Padding="0,11,0,8"/>
                    <Border Height="2" CornerRadius="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FF0028" Offset="0"/>
                                <GradientStop Color="#E8002D" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ LIVE BANNER ═══ -->
        <Border Grid.Row="2">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#3A0000" Offset="0"/>
                    <GradientStop Color="#1A0000" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="14,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#E8002D" CornerRadius="5" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal" Margin="8,4">
                        <Ellipse Fill="White" Width="6" Height="6"
                                 VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="EN DIRECT" Foreground="White"
                                   FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="GRAND PRIX DE MONACO" Foreground="White"
                               FontSize="13" FontWeight="Bold"/>
                    <TextBlock Foreground="#AAAAAA" FontSize="10">
                        <Run Text="Circuit de Monaco  •  Tour "/>
                        <Run Text="52" Foreground="White" FontWeight="Bold"/>
                        <Run Text=" / 78"/>
                    </TextBlock>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="🇲🇨" FontSize="26" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ═══ SCROLL CONTENT ═══ -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Hidden" Background="#0A0A0A">
            <StackPanel Margin="12,10,12,12">

                <!-- CHRONO + MÉTÉO -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <StackPanel Margin="12,10">
                            <TextBlock Text="TEMPS ÉCOULÉ" Foreground="#8A8A8A"
                                       FontSize="9" FontWeight="Bold" Margin="0,0,0,6"/>
                            <TextBlock Text="1:24:38" Foreground="White"
                                       FontSize="28" FontWeight="Bold"/>
                            <Border Background="#2A2A2A" Height="2" CornerRadius="1" Margin="0,6,0,0">
                                <Border Background="#E8002D" Height="2" Width="200"
                                        CornerRadius="1" HorizontalAlignment="Left"/>
                            </Border>
                            <TextBlock Foreground="#8A8A8A" FontSize="9" Margin="0,4,0,0">
                                <Run Text="Fin estimée: "/>
                                <Run Text="15:48" Foreground="White" FontWeight="Bold"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel Margin="12,10">
                            <TextBlock Text="CONDITIONS" Foreground="#8A8A8A"
                                       FontSize="9" FontWeight="Bold" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="🌤" FontSize="22" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="24°C" Foreground="White"
                                           FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Piste: 38°C" Foreground="#8A8A8A" FontSize="10"/>
                            <TextBlock Text="Vent: 12 km/h" Foreground="#8A8A8A" FontSize="10"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- LEADER -->
                <Border Margin="0,0,0,10" CornerRadius="10" ClipToBounds="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#1A1A3A" Offset="0"/>
                            <GradientStop Color="#0D0D2A" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid Margin="14,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#3B6FE8" CornerRadius="8"
                                Width="44" Height="44" Margin="0,0,12,0">
                            <TextBlock Text="1" Foreground="White" FontSize="22"
                                       FontWeight="Bold" FontStyle="Italic"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Border Background="#E8002D" CornerRadius="3" Padding="5,2"
                                    HorizontalAlignment="Left" Margin="0,0,0,4">
                                <TextBlock Text="🏆 EN TÊTE" Foreground="White"
                                           FontSize="8" FontWeight="Bold"/>
                            </Border>
                            <TextBlock Text="M. VERSTAPPEN" Foreground="White"
                                       FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="Red Bull Racing" Foreground="#8A8A8A" FontSize="10"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="1:14.234" Foreground="#3B6FE8"
                                       FontSize="16" FontWeight="Bold" HorizontalAlignment="Right"/>
                            <TextBlock Text="Meilleur tour" Foreground="#8A8A8A"
                                       FontSize="9" HorizontalAlignment="Right"/>
                            <Border Background="#1A2A1A" BorderBrush="#2A4A2A"
                                    BorderThickness="1" CornerRadius="4" Margin="0,4,0,0">
                                <TextBlock Text="⚡ +4.2s" Foreground="#4CAF50"
                                           FontSize="11" FontWeight="Bold" Margin="6,3"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- CLASSEMENT LIVE -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel Margin="14,12">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Ellipse Fill="#E8002D" Width="7" Height="7"
                                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="CLASSEMENT EN DIRECT" Foreground="White"
                                           FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Foreground="#8A8A8A"
                                       FontSize="10" VerticalAlignment="Center">
                                <Run Text="Tour "/><Run Text="52" Foreground="White" FontWeight="Bold"/>
                            </TextBlock>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="55"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="P" Foreground="#5A5A5A" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="PILOTE" Foreground="#5A5A5A" FontSize="9" FontWeight="Bold" Margin="6,0,0,0"/>
                            <TextBlock Grid.Column="3" Text="ÉCART" Foreground="#5A5A5A" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="PNEU" Foreground="#5A5A5A" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </Grid>
                        <!-- P1 -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="55"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="1" Foreground="#E8002D" FontSize="15" FontWeight="Bold" FontStyle="Italic" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="#3B6FE8" Width="3" CornerRadius="2" HorizontalAlignment="Left"/>
                            <StackPanel Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="M. VERSTAPPEN" Foreground="White" FontSize="12" FontWeight="Bold"/>
                                <TextBlock Text="Red Bull" Foreground="#8A8A8A" FontSize="9"/>
                            </StackPanel>
                            <TextBlock Grid.Column="3" Text="LEADER" Foreground="#E8002D" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border Grid.Column="4" Background="#CC2200" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="🔴 DUR" Foreground="White" FontSize="9" FontWeight="Bold" Margin="5,3"/>
                            </Border>
                        </Grid>
                        <Border Background="#2A2A2A" Height="1" Margin="0,0,0,8"/>
                        <!-- P2 -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="55"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="2" Foreground="#8A8A8A" FontSize="15" FontWeight="Bold" FontStyle="Italic" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="#E8002D" Width="3" CornerRadius="2" HorizontalAlignment="Left"/>
                            <StackPanel Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="C. LECLERC" Foreground="White" FontSize="12" FontWeight="Bold"/>
                                <TextBlock Text="Ferrari" Foreground="#8A8A8A" FontSize="9"/>
                            </StackPanel>
                            <TextBlock Grid.Column="3" Text="+4.218s" Foreground="#8A8A8A" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border Grid.Column="4" Background="#CCAA00" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="🟡 MED" Foreground="White" FontSize="9" FontWeight="Bold" Margin="5,3"/>
                            </Border>
                        </Grid>
                        <Border Background="#2A2A2A" Height="1" Margin="0,0,0,8"/>
                        <!-- P3 -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="55"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="3" Foreground="#8A8A8A" FontSize="15" FontWeight="Bold" FontStyle="Italic" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="#00D2BE" Width="3" CornerRadius="2" HorizontalAlignment="Left"/>
                            <StackPanel Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="L. HAMILTON" Foreground="White" FontSize="12" FontWeight="Bold"/>
                                <TextBlock Text="Mercedes" Foreground="#8A8A8A" FontSize="9"/>
                            </StackPanel>
                            <TextBlock Grid.Column="3" Text="+7.542s" Foreground="#8A8A8A" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border Grid.Column="4" Background="#CCAA00" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="🟡 MED" Foreground="White" FontSize="9" FontWeight="Bold" Margin="5,3"/>
                            </Border>
                        </Grid>
                        <Border Background="#2A2A2A" Height="1" Margin="0,0,0,8"/>
                        <!-- P4 -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="55"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="4" Foreground="#8A8A8A" FontSize="14" FontWeight="Bold" FontStyle="Italic" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="#FF8000" Width="3" CornerRadius="2" HorizontalAlignment="Left"/>
                            <StackPanel Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="L. NORRIS" Foreground="White" FontSize="12" FontWeight="Bold"/>
                                <TextBlock Text="McLaren" Foreground="#8A8A8A" FontSize="9"/>
                            </StackPanel>
                            <TextBlock Grid.Column="3" Text="+12.001s" Foreground="#8A8A8A" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border Grid.Column="4" Background="#336600" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="🟢 TEN" Foreground="White" FontSize="9" FontWeight="Bold" Margin="5,3"/>
                            </Border>
                        </Grid>
                        <Border Background="#2A2A2A" Height="1" Margin="0,0,0,8"/>
                        <!-- P5 -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="55"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="5" Foreground="#8A8A8A" FontSize="14" FontWeight="Bold" FontStyle="Italic" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="#E8002D" Width="3" CornerRadius="2" HorizontalAlignment="Left"/>
                            <StackPanel Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="C. SAINZ" Foreground="White" FontSize="12" FontWeight="Bold"/>
                                <TextBlock Text="Ferrari" Foreground="#8A8A8A" FontSize="9"/>
                            </StackPanel>
                            <TextBlock Grid.Column="3" Text="+15.334s" Foreground="#8A8A8A" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border Grid.Column="4" Background="#CC2200" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="🔴 DUR" Foreground="White" FontSize="9" FontWeight="Bold" Margin="5,3"/>
                            </Border>
                        </Grid>
                        <Border Background="#2A2A2A" Height="1" Margin="0,0,0,8"/>
                        <!-- P6 -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="55"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="6" Foreground="#8A8A8A" FontSize="14" FontWeight="Bold" FontStyle="Italic" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="#358C75" Width="3" CornerRadius="2" HorizontalAlignment="Left"/>
                            <StackPanel Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="F. ALONSO" Foreground="White" FontSize="12" FontWeight="Bold"/>
                                <TextBlock Text="Aston Martin" Foreground="#8A8A8A" FontSize="9"/>
                            </StackPanel>
                            <TextBlock Grid.Column="3" Text="+19.887s" Foreground="#8A8A8A" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border Grid.Column="4" Background="#CC2200" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="🔴 DUR" Foreground="White" FontSize="9" FontWeight="Bold" Margin="5,3"/>
                            </Border>
                        </Grid>
                        <Border Background="#2A2A2A" Height="1" Margin="0,0,0,8"/>
                        <!-- Reste compressé -->
                        <Border Background="#141414" CornerRadius="6">
                            <StackPanel Margin="10,8">
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="7" Foreground="#5A5A5A" FontSize="11" FontWeight="Bold" FontStyle="Italic" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Background="#00D2BE" Width="2" CornerRadius="1" HorizontalAlignment="Left"/>
                                    <TextBlock Grid.Column="2" Text="G. RUSSELL" Foreground="#AAAAAA" FontSize="11" FontWeight="Bold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="+22.1s" Foreground="#5A5A5A" FontSize="10" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="8" Foreground="#5A5A5A" FontSize="11" FontWeight="Bold" FontStyle="Italic" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Background="#358C75" Width="2" CornerRadius="1" HorizontalAlignment="Left"/>
                                    <TextBlock Grid.Column="2" Text="L. STROLL" Foreground="#AAAAAA" FontSize="11" FontWeight="Bold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="+28.4s" Foreground="#5A5A5A" FontSize="10" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="9" Foreground="#5A5A5A" FontSize="11" FontWeight="Bold" FontStyle="Italic" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Background="#FF8000" Width="2" CornerRadius="1" HorizontalAlignment="Left"/>
                                    <TextBlock Grid.Column="2" Text="O. PIASTRI" Foreground="#AAAAAA" FontSize="11" FontWeight="Bold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="+31.7s" Foreground="#5A5A5A" FontSize="10" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="10" Foreground="#5A5A5A" FontSize="11" FontWeight="Bold" FontStyle="Italic" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Background="#3B6FE8" Width="2" CornerRadius="1" HorizontalAlignment="Left"/>
                                    <TextBlock Grid.Column="2" Text="S. PÉREZ" Foreground="#AAAAAA" FontSize="11" FontWeight="Bold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="+38.2s" Foreground="#5A5A5A" FontSize="10" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Background="#1A1A1A" BorderBrush="#2A2A2A"
                                BorderThickness="1" CornerRadius="6"
                                Cursor="Hand" Margin="0,8,0,0"
                                MouseLeftButtonDown="VoirTout_Click">
                            <TextBlock Text="Voir les 22 pilotes  ›"
                                       Foreground="#8A8A8A" FontSize="11"
                                       FontWeight="Bold" HorizontalAlignment="Center"
                                       Margin="0,8"/>
