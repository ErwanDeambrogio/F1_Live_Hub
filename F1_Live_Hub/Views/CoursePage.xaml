<Window x:Class="F1_Live_Hub.Views.CoursePage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="F1 Live Hub - Course" Height="900" Width="420"
        Background="#0D0D0D" WindowStyle="None"
        AllowsTransparency="True" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Hidden">
            <StackPanel>

                <!-- TOP BAR -->
                <Grid Height="56" Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="22" Height="22" Background="#E10600"
                                CornerRadius="4" Margin="0,0,6,0">
                            <TextBlock Text="F1" Foreground="White" FontSize="9" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="F1 HUB" Foreground="White" FontSize="16"
                                   FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="🔔" FontSize="18"
                               Foreground="White" VerticalAlignment="Center"/>
                </Grid>

                <!-- NAV TABS -->
                <Grid Height="40" Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Classement" Foreground="#888888"
                               FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Cursor="Hand" MouseLeftButtonDown="Tab_Classement_Click"/>
                    <TextBlock Grid.Column="1" Text="Pilotes" Foreground="#888888"
                               FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Cursor="Hand" MouseLeftButtonDown="Tab_Pilotes_Click"/>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Course" Foreground="#E10600" FontSize="12"
                                   FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <Rectangle Height="2" Fill="#E10600" Width="46" Margin="0,4,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="3" Text="Météo" Foreground="#888888"
                               FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Cursor="Hand" MouseLeftButtonDown="Tab_Meteo_Click"/>
                </Grid>

                <!-- BOUTONS LAST / NEXT -->
                <Grid Margin="16,10,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Cursor="Hand" Click="BtnLast_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#1A1A1A" CornerRadius="8"
                                        BorderBrush="#333333" BorderThickness="1">
                                    <TextBlock Text="⬅  Dernière" Foreground="White"
                                               FontSize="11" FontWeight="Bold"
                                               HorizontalAlignment="Center" Margin="0,10"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Grid.Column="2" Cursor="Hand" Click="BtnNext_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#E10600" CornerRadius="8">
                                    <TextBlock Text="Prochaine  ➡" Foreground="White"
                                               FontSize="11" FontWeight="Bold"
                                               HorizontalAlignment="Center" Margin="0,10"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- RECHERCHE PAR ANNÉE / ROUND -->
                <Border Margin="16,10,16,0" Background="#1A1A1A" CornerRadius="10" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="🔍  RECHERCHER UNE COURSE" Foreground="#888888"
                                   FontSize="9" FontWeight="Bold" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="44"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#111111"
                                    CornerRadius="6" BorderBrush="#333333" BorderThickness="1">
                                <TextBox x:Name="TxtYear" Background="Transparent"
                                         Foreground="White" FontSize="13" FontWeight="Bold"
                                         BorderThickness="0" Padding="10,7"
                                         Text="2024" CaretBrush="White"/>
                            </Border>
                            <Border Grid.Column="2" Background="#111111"
                                    CornerRadius="6" BorderBrush="#333333" BorderThickness="1">
                                <TextBox x:Name="TxtRound" Background="Transparent"
                                         Foreground="White" FontSize="13" FontWeight="Bold"
                                         BorderThickness="0" Padding="10,7"
                                         Text="1" CaretBrush="White"/>
                            </Border>
                            <Button Grid.Column="4" Cursor="Hand" Click="BtnSearch_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="#E10600" CornerRadius="6">
                                            <TextBlock Text="OK" Foreground="White"
                                                       FontSize="11" FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" Margin="0,8"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="2,5,0,0">
                            <TextBlock Text="Année" Foreground="#555555" FontSize="9"/>
                            <TextBlock Text="                              Round"
                                       Foreground="#555555" FontSize="9"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- CHARGEMENT -->
                <Border Margin="16,8,16,0" Background="#1A1A1A" CornerRadius="8" Padding="12,8"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="⏳  Chargement..." Foreground="#888888"
                               FontSize="11" HorizontalAlignment="Center"/>
                </Border>

                <!-- ERREUR -->
                <Border Margin="16,8,16,0" Background="#2A0000" CornerRadius="8" Padding="12,8"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#E10600"
                               FontSize="11" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                </Border>

                <!-- HERO COURSE -->
                <Border Margin="16,10,16,0" Background="#1A1A1A" CornerRadius="12" Padding="16,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border Background="#E10600" CornerRadius="4" Padding="7,3" Margin="0,0,8,0">
                                <TextBlock Text="{Binding Round, StringFormat='Round {0}'}"
                                           Foreground="White" FontSize="10" FontWeight="Bold"/>
                            </Border>
                            <TextBlock Text="{Binding Year}" Foreground="#888888"
                                       FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding RaceName}" Foreground="White"
                                   FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{Binding City}" Foreground="#888888" FontSize="12"/>
                            <TextBlock Text="  ·  " Foreground="#444444" FontSize="12"/>
                            <TextBlock Text="{Binding Country}" Foreground="#888888" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- INFOS CIRCUIT -->
                <Border Margin="16,8,16,0" Background="#1A1A1A" CornerRadius="12" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="CIRCUIT" Foreground="#888888"
                                   FontSize="9" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding CircuitName}" Foreground="White"
                                   FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="LONGUEUR" Foreground="#555555"
                                           FontSize="9" FontWeight="Bold" Margin="0,0,0,3"/>
                                <TextBlock Text="{Binding CircuitLength}" Foreground="White"
                                           FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="VIRAGES" Foreground="#555555"
                                           FontSize="9" FontWeight="Bold" Margin="0,0,0,3"/>
                                <TextBlock Text="{Binding Corners}" Foreground="White"
                                           FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="1ÈRE COURSE" Foreground="#555555"
                                           FontSize="9" FontWeight="Bold" Margin="0,0,0,3"/>
                                <TextBlock Text="{Binding CircuitFirstYear}" Foreground="White"
                                           FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>
                        <Rectangle Height="1" Fill="#2A2A2A" Margin="0,4,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="RECORD DU TOUR" Foreground="#555555"
                                           FontSize="9" FontWeight="Bold" Margin="0,0,0,3"/>
                                <TextBlock Text="{Binding LapRecord}" Foreground="#E10600"
                                           FontSize="13" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="MEILLEUR TOUR COURSE" Foreground="#555555"
                                           FontSize="9" FontWeight="Bold" Margin="0,0,0,3"/>
                                <TextBlock Text="{Binding FastLap}" Foreground="White"
                                           FontSize="13" FontWeight="Bold"/>
                                <TextBlock Text="{Binding FastLapDriverId}" Foreground="#888888"
                                           FontSize="10"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- SESSIONS -->
                <Border Margin="16,8,16,0" Background="#1A1A1A" CornerRadius="12" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="SESSIONS" Foreground="#888888"
                                   FontSize="9" FontWeight="Bold" Margin="0,0,0,10"/>

                        <!-- FP1 -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#222222" CornerRadius="6"
                                    Width="28" Height="28" HorizontalAlignment="Left">
                                <TextBlock Text="P1" Foreground="#888888" FontSize="10" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="Essais Libres 1" Foreground="White"
                                       FontSize="12" VerticalAlignment="Center" Margin="10,0"/>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding Fp1Date}" Foreground="#888888"
                                           FontSize="11" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding Fp1Time}" Foreground="#555555"
                                           FontSize="10" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>

                        <!-- FP2 -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#222222" CornerRadius="6"
                                    Width="28" Height="28" HorizontalAlignment="Left">
                                <TextBlock Text="P2" Foreground="#888888" FontSize="10" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="Essais Libres 2" Foreground="White"
                                       FontSize="12" VerticalAlignment="Center" Margin="10,0"/>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding Fp2Date}" Foreground="#888888"
                                           FontSize="11" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding Fp2Time}" Foreground="#555555"
                                           FontSize="10" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>

                        <!-- FP3 -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#222222" CornerRadius="6"
                                    Width="28" Height="28" HorizontalAlignment="Left">
                                <TextBlock Text="P3" Foreground="#888888" FontSize="10" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="Essais Libres 3" Foreground="White"
                                       FontSize="12" VerticalAlignment="Center" Margin="10,0"/>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding Fp3Date}" Foreground="#888888"
                                           FontSize="11" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding Fp3Time}" Foreground="#555555"
                                           FontSize="10" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>

                        <!-- SPRINT QUALY -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#1A1500" CornerRadius="6"
                                    Width="28" Height="28" HorizontalAlignment="Left">
                                <TextBlock Text="SQ" Foreground="#FFD700" FontSize="9" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="Sprint Qualifs" Foreground="White"
                                       FontSize="12" VerticalAlignment="Center" Margin="10,0"/>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding SprintQualyDate}" Foreground="#FFD700"
                                           FontSize="11" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>

                        <!-- SPRINT RACE -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#1A1500" CornerRadius="6"
                                    Width="28" Height="28" HorizontalAlignment="Left">
                                <TextBlock Text="SP" Foreground="#FFD700" FontSize="10" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="Sprint" Foreground="White"
                                       FontSize="12" VerticalAlignment="Center" Margin="10,0"/>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding SprintRaceDate}" Foreground="#FFD700"
                                           FontSize="11" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding SprintRaceTime}" Foreground="#555555"
                                           FontSize="10" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>

                        <!-- QUALIFS -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#111133" CornerRadius="6"
                                    Width="28" Height="28" HorizontalAlignment="Left">
                                <TextBlock Text="Q" Foreground="#4488FF" FontSize="11" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="Qualifications" Foreground="White"
                                       FontSize="12" VerticalAlignment="Center" Margin="10,0"/>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding QualyDate}" Foreground="#4488FF"
                                           FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding QualyTime}" Foreground="#555555"
                                           FontSize="10" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>

                        <!-- COURSE -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#2A0000" CornerRadius="6"
                                    Width="28" Height="28" HorizontalAlignment="Left">
                                <TextBlock Text="R" Foreground="#E10600" FontSize="11" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                                <TextBlock Text="Course" Foreground="White"
                                           FontSize="12" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Laps, StringFormat='{}{0} tours'}"
                                           Foreground="#555555" FontSize="10"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding RaceDate}" Foreground="#E10600"
                                           FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding RaceTime}" Foreground="#555555"
                                           FontSize="10" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- VAINQUEURS -->
                <Border Margin="16,8,16,0" Background="#1A1A1A" CornerRadius="12" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="VAINQUEURS" Foreground="#888888"
                                   FontSize="9" FontWeight="Bold" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Pilote -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="🏆  PILOTE" Foreground="#555555"
                                           FontSize="9" FontWeight="Bold" Margin="0,0,0,6"/>
                                <Border Background="#2A0000" CornerRadius="6" Padding="6,3"
                                        HorizontalAlignment="Left" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding WinnerShortName}"
                                               Foreground="#E10600" FontSize="11" FontWeight="Bold"/>
                                </Border>
                                <TextBlock Text="{Binding WinnerName}" Foreground="White"
                                           FontSize="14" FontWeight="Bold"/>
                                <TextBlock Text="{Binding WinnerSurname}" Foreground="#E10600"
                                           FontSize="14" FontWeight="Bold"/>
                                <TextBlock Text="{Binding WinnerCountry}" Foreground="#888888"
                                           FontSize="10" Margin="0,3,0,0"/>
                                <TextBlock Text="{Binding WinnerNumber, StringFormat='#{0}'}"
                                           Foreground="#555555" FontSize="10"/>
                            </StackPanel>

                            <Rectangle Grid.Column="1" Fill="#2A2A2A"/>

                            <!-- Équipe -->
                            <StackPanel Grid.Column="2" Margin="14,0,0,0">
                                <TextBlock Text="🏎  ÉQUIPE" Foreground="#555555"
                                           FontSize="9" FontWeight="Bold" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding TeamWinnerName}" Foreground="White"
                                           FontSize="14" FontWeight="Bold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding TeamWinnerCountry}" Foreground="#888888"
                                           FontSize="10" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Rectangle Height="90"/>
            </StackPanel>
        </ScrollViewer>

        <!-- BOTTOM NAV BAR -->
        <Border VerticalAlignment="Bottom" Height="70" Background="#111111"
                BorderThickness="0,1,0,0" BorderBrush="#222222">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" HorizontalAlignment="Center"
                            Cursor="Hand" MouseLeftButtonDown="Nav_Live_Click">
                    <TextBlock Text="📡" FontSize="18" HorizontalAlignment="Center"/>
                    <TextBlock Text="LIVE" Foreground="#555555" FontSize="8"
                               FontWeight="Bold" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Center"
                            Cursor="Hand" MouseLeftButtonDown="Nav_Standings_Click">
                    <TextBlock Text="📊" FontSize="18" HorizontalAlignment="Center"/>
                    <TextBlock Text="STANDINGS" Foreground="#555555" FontSize="8"
                               FontWeight="Bold" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="🏁" FontSize="18" HorizontalAlignment="Center"/>
                    <TextBlock Text="COURSE" Foreground="#E10600" FontSize="8"
                               FontWeight="Bold" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    <Border Background="#E10600" Height="2" Width="18" CornerRadius="1"
                            HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="3" HorizontalAlignment="Center"
                            Cursor="Hand" MouseLeftButtonDown="Nav_Calendar_Click">
                    <TextBlock Text="📅" FontSize="18" HorizontalAlignment="Center"/>
                    <TextBlock Text="CALENDAR" Foreground="#555555" FontSize="8"
                               FontWeight="Bold" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="4" HorizontalAlignment="Center"
                            Cursor="Hand" MouseLeftButtonDown="Nav_Hub_Click">
                    <TextBlock Text="⚙" FontSize="18" Foreground="#555555"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="HUB" Foreground="#555555" FontSize="8"
                               FontWeight="Bold" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>