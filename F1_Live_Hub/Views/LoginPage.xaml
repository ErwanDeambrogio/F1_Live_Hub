<Window x:Class="F1_Live_Hub.Views.LoginPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        WindowStyle="None" AllowsTransparency="True"
        ResizeMode="NoResize"
        Title="F1 Live Hub - Connexion" Height="900" Width="420"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#111111" Offset="0"/>
                <GradientStop Color="#0A0A0A" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Line X1="320" Y1="100" X2="500" Y2="420"
              Stroke="#E10600" StrokeThickness="1.5"
              Opacity="0.25" HorizontalAlignment="Right"/>

        <Ellipse Width="400" Height="400"
                 HorizontalAlignment="Left" VerticalAlignment="Center"
                 Margin="-180,0,0,100" Opacity="0.08">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#E10600" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <ScrollViewer VerticalScrollBarVisibility="Hidden">
            <StackPanel>

                <!-- LOGO -->
                <StackPanel HorizontalAlignment="Center" Margin="0,60,0,40">
                    <Border Width="80" Height="80" CornerRadius="22"
                            HorizontalAlignment="Center" Margin="0,0,0,18">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF2200" Offset="0"/>
                                <GradientStop Color="#C10000" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect Color="#E10600" BlurRadius="24"
                                              Opacity="0.6" ShadowDepth="0"/>
                        </Border.Effect>
                        <TextBlock Text="🏎" FontSize="36"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="F1 LIVE HUB" Foreground="White"
                               FontSize="24" FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- CARTE -->
                <Border Margin="20,0,20,0" CornerRadius="20" Padding="28,32">
                    <Border.Background>
                        <SolidColorBrush Color="#1E1E1E"/>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="30"
                                          Opacity="0.4" ShadowDepth="0"/>
                    </Border.Effect>

                    <StackPanel>

                        <TextBlock Text="CONNEXION" Foreground="White"
                                   FontSize="32" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,0,0,8"/>

                        <TextBlock Text="Accédez à votre paddock personnel"
                                   Foreground="#AAAAAA" FontSize="13"
                                   HorizontalAlignment="Center" Margin="0,0,0,28"/>

                        <!-- MESSAGE ERREUR -->
                        <Border x:Name="TxtErrorBorder" Background="#2A0000"
                                CornerRadius="8" Padding="12,8" Margin="0,0,0,16"
                                Visibility="Collapsed">
                            <TextBlock x:Name="TxtError" Foreground="#FF6666"
                                       FontSize="12" TextWrapping="Wrap"/>
                        </Border>

                        <!-- NOM D'UTILISATEUR -->
                        <TextBlock Text="NOM D'UTILISATEUR" Foreground="#CCCCCC"
                                   FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
                        <Border Background="#2A2A2A" CornerRadius="12"
                                Height="58" Padding="16,0" Margin="0,0,0,24">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="👤" FontSize="18"
                                           Foreground="#666666" VerticalAlignment="Center"
                                           Margin="0,0,12,0"/>
                                <TextBox x:Name="TxtUsername"
                                         Grid.Column="1" Background="Transparent"
                                         BorderThickness="0" Foreground="White"
                                         FontSize="15" VerticalAlignment="Center"
                                         CaretBrush="White"/>
                            </Grid>
                        </Border>

                        <!-- MOT DE PASSE -->
                        <TextBlock Text="MOT DE PASSE" Foreground="#CCCCCC"
                                   FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
                        <Border Background="#2A2A2A" CornerRadius="12"
                                Height="58" Padding="16,0" Margin="0,0,0,24">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🔒" FontSize="18"
                                           Foreground="#666666" VerticalAlignment="Center"
                                           Margin="0,0,12,0"/>
                                <PasswordBox x:Name="PwdPassword"
                                             Grid.Column="1" Background="Transparent"
                                             BorderThickness="0" Foreground="White"
                                             FontSize="15" VerticalAlignment="Center"
                                             CaretBrush="White"/>
                            </Grid>
                        </Border>

                        <!-- BOUTON SE CONNECTER -->
                        <Button Cursor="Hand" BorderThickness="0"
                                Background="Transparent"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,16"
                                Click="ConnecterButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" CornerRadius="12" Height="60">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#E10600" Offset="0"/>
                                                <GradientStop Color="#FF2200" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border.Effect>
                                            <DropShadowEffect Color="#E10600" BlurRadius="24"
                                                              Opacity="0.55" ShadowDepth="0"/>
                                        </Border.Effect>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="SE CONNECTER" Foreground="White"
                                                       FontSize="16" FontWeight="Bold"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="  🏁" FontSize="18"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                    </StackPanel>
                </Border>

                <Border Height="120" Background="Transparent">
                    <TextBlock Text="🏎️" FontSize="90"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" Opacity="0.18"/>
                </Border>

                <!-- PAS DE COMPTE -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center" Margin="0,10,0,30">
                    <TextBlock Text="Pas de compte ? " Foreground="#888888" FontSize="14"/>
                    <TextBlock Text="Créer un profil" Foreground="White"
                               FontSize="14" FontWeight="Bold"
                               TextDecorations="Underline" Cursor="Hand"
                               MouseLeftButtonDown="CreerProfil_Click"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>