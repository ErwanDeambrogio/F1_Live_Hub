<Window x:Class="F1_Live_Hub.Views.LoginPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="F1 Live Hub - Connexion" Height="900" Width="420"
        WindowStyle="SingleBorderWindow" ResizeMode="CanMinimize">

    <Grid>

        <!-- ═══════════════════════════════ -->
        <!-- FOND GÉNÉRAL SOMBRE             -->
        <!-- ═══════════════════════════════ -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#111111" Offset="0"/>
                <GradientStop Color="#0A0A0A" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- LIGNE DIAGONALE ROUGE (déco fond) -->
        <Line X1="320" Y1="100" X2="500" Y2="420"
              Stroke="#E10600" StrokeThickness="1.5"
              Opacity="0.25" HorizontalAlignment="Right"/>

        <!-- GLOW ROUGE CENTRE-GAUCHE -->
        <Ellipse Width="400" Height="400"
                 HorizontalAlignment="Left" VerticalAlignment="Center"
                 Margin="-180,0,0,100" Opacity="0.08">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#E10600" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <ScrollViewer VerticalScrollBarVisibility="Hidden">
            <StackPanel>

                <!-- ═══════════════════════════════ -->
                <!-- LOGO + TITRE                    -->
                <!-- ═══════════════════════════════ -->
                <StackPanel HorizontalAlignment="Center" Margin="0,60,0,40">

                    <!-- Icône ronde rouge -->
                    <Border Width="80" Height="80" CornerRadius="22"
                            HorizontalAlignment="Center" Margin="0,0,0,18">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF2200" Offset="0"/>
                                <GradientStop Color="#C10000" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect Color="#E10600" BlurRadius="24"
                                              Opacity="0.6" ShadowDepth="0"/>
                        </Border.Effect>
                        <TextBlock Text="🏎" FontSize="36"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <!-- Titre -->
                    <TextBlock Text="F1 LIVE HUB" Foreground="White"
                               FontSize="24" FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- ═══════════════════════════════ -->
                <!-- VOITURE EN BAS (derrière carte) -->
                <!-- ═══════════════════════════════ -->

                <!-- ═══════════════════════════════ -->
                <!-- CARTE CONNEXION                 -->
                <!-- ═══════════════════════════════ -->
                <Border Margin="20,0,20,0" CornerRadius="20" Padding="28,32">
                    <Border.Background>
                        <SolidColorBrush Color="#1E1E1E"/>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="30"
                                          Opacity="0.4" ShadowDepth="0"/>
                    </Border.Effect>

                    <StackPanel>

                        <!-- Titre CONNEXION -->
                        <TextBlock Text="CONNEXION" Foreground="White"
                                   FontSize="32" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,0,0,8"/>

                        <!-- Sous-titre -->
                        <TextBlock Text="Accédez à votre paddock personnel"
                                   Foreground="#AAAAAA" FontSize="13"
                                   HorizontalAlignment="Center" Margin="0,0,0,32"/>

                        <!-- ─── NOM D'UTILISATEUR ─── -->
                        <TextBlock Text="NOM D'UTILISATEUR" Foreground="#CCCCCC"
                                   FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
                        <Border Background="#2A2A2A" CornerRadius="12"
                                Height="58" Padding="16,0" Margin="0,0,0,24">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="👤" FontSize="18"
                                           Foreground="#666666" VerticalAlignment="Center"
                                           Margin="0,0,12,0"/>
                                <TextBox Grid.Column="1" Background="Transparent"
                                         BorderThickness="0" Foreground="#666666"
                                         FontSize="15" VerticalAlignment="Center"
                                         CaretBrush="White" Text="Pilote_123"/>
                            </Grid>
                        </Border>

                        <!-- ─── MOT DE PASSE ─── -->
                        <TextBlock Text="MOT DE PASSE" Foreground="#CCCCCC"
                                   FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
                        <Border Background="#2A2A2A" CornerRadius="12"
                                Height="58" Padding="16,0" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🔒" FontSize="18"
                                           Foreground="#666666" VerticalAlignment="Center"
                                           Margin="0,0,12,0"/>
                                <PasswordBox Grid.Column="1" Background="Transparent"
                                             BorderThickness="0" Foreground="#888888"
                                             FontSize="15" VerticalAlignment="Center"
                                             CaretBrush="White" Password="12345678"/>
                                <TextBlock Grid.Column="2" Text="👁" FontSize="18"
                                           Foreground="#666666" VerticalAlignment="Center"
                                           Cursor="Hand"/>
                            </Grid>
                        </Border>

                        <!-- Mot de passe oublié -->
                        <TextBlock Text="Mot de passe oublié ?" Foreground="#E10600"
                                   FontSize="13" HorizontalAlignment="Right"
                                   Cursor="Hand" Margin="0,0,0,28"/>

                        <!-- ─── BOUTON SE CONNECTER ─── -->
                        <Button Cursor="Hand" BorderThickness="0"
                                Background="Transparent"
                                HorizontalAlignment="Stretch" Margin="0,0,0,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="12" Height="60">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#E10600" Offset="0"/>
                                                <GradientStop Color="#FF2200" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border.Effect>
                                            <DropShadowEffect Color="#E10600" BlurRadius="24"
                                                              Opacity="0.55" ShadowDepth="0"/>
                                        </Border.Effect>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="SE CONNECTER" Foreground="White"
                                                       FontSize="16" FontWeight="Bold"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="  🏁" FontSize="18"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                    </StackPanel>
                </Border>

                <!-- ═══════════════════════════════ -->
                <!-- VOITURE PLACEHOLDER             -->
                <!-- ═══════════════════════════════ -->
                <Border Height="120" Margin="0,0,0,0" Background="Transparent">
                    <TextBlock Text="🏎️" FontSize="90"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" Opacity="0.18"/>
                </Border>

                <!-- ═══════════════════════════════ -->
                <!-- PAS DE COMPTE                   -->
                <!-- ═══════════════════════════════ -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center" Margin="0,10,0,30">
                    <TextBlock Text="Pas de compte ? " Foreground="#888888" FontSize="14"/>
                    <TextBlock Text="Créer un profil" Foreground="White"
                               FontSize="14" FontWeight="Bold"
                               TextDecorations="Underline" Cursor="Hand"/>
                </StackPanel>

                <!-- ═══════════════════════════════ -->
                <!-- ICÔNES BAS DE PAGE              -->
                <!-- ═══════════════════════════════ -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center" Margin="0,0,0,30">
                    <TextBlock Text="📡" FontSize="22" Foreground="#444444"
                               Margin="0,0,28,0" Cursor="Hand"/>
                    <TextBlock Text="⏱" FontSize="22" Foreground="#444444"
                               Margin="0,0,28,0" Cursor="Hand"/>
                    <TextBlock Text="📊" FontSize="22" Foreground="#444444"
                               Cursor="Hand"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>