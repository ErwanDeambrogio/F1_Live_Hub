<Window x:Class="F1_Live_Hub.Views.CircuitsPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Title="F1 Live Hub - Circuits"
        Height="900" Width="420"
        Background="#0D0D0D"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="#111111"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>
        <Style x:Key="LabelCap" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A8A8A"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="Separator" TargetType="Border">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="0,6"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════ -->
        <!--  CONTENU PRINCIPAL (scroll)                 -->
        <!-- ═══════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                      Background="#0D0D0D">
            <StackPanel Margin="12,0,12,12">

                <!-- ─────────────────────────────────── -->
                <!--  HEADER COMMUN                      -->
                <!-- ─────────────────────────────────── -->
                <Grid Margin="0,14,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#E8002D" CornerRadius="6"
                            Width="28" Height="28" Margin="0,0,8,0">
                        <TextBlock Text="F1" Foreground="White" FontSize="11"
                                   FontWeight="Bold" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Grid.Column="1" Text="F1 HUB"
                               Foreground="White" FontSize="16" FontWeight="Bold"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="2" Text="🔍" Foreground="White"
                               FontSize="18" VerticalAlignment="Center"
                               Margin="0,0,12,0"/>

                    <Grid Grid.Column="3" Width="28" Height="28">
                        <TextBlock Text="🔔" Foreground="White"
                                   FontSize="18" VerticalAlignment="Center"/>
                        <Border Background="#E8002D" Width="8" Height="8"
                                CornerRadius="4"
                                HorizontalAlignment="Right" VerticalAlignment="Top"/>
                    </Grid>
                </Grid>

                <!-- ─────────────────────────────────── -->
                <!--  TABS                               -->
                <!-- ─────────────────────────────────── -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Classement"
                               Foreground="#5A5A5A" FontSize="13"
                               HorizontalAlignment="Center" Cursor="Hand"
                               MouseLeftButtonDown="Tab_Classement_Click"/>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="Circuits" Foreground="#E8002D"
                                   FontSize="13" FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                        <Border Background="#E8002D" Height="2" Width="50"
                                CornerRadius="1" Margin="0,4,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="Course"
                               Foreground="#5A5A5A" FontSize="13"
                               HorizontalAlignment="Center" Cursor="Hand"
                               MouseLeftButtonDown="Tab_Course_Click"/>

                    <TextBlock Grid.Column="3" Text="Météo"
                               Foreground="#5A5A5A" FontSize="13"
                               HorizontalAlignment="Center" Cursor="Hand"
                               MouseLeftButtonDown="Tab_Meteo_Click"/>
                </Grid>

                <!-- ═══════════════════════════════════════════ -->
                <!--  PANNEAU RECHERCHE                          -->
                <!-- ═══════════════════════════════════════════ -->
                <StackPanel x:Name="PanelRecherche" Visibility="Visible">

                    <!-- Titre -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="CIRCUIT " Foreground="White"
                                   FontSize="28" FontWeight="Bold"/>
                        <TextBlock Text="TELEMETRY" Foreground="#E8002D"
                                   FontSize="28" FontWeight="Bold" FontStyle="Italic"/>
                    </StackPanel>

                    <!-- Barre de recherche -->
                    <Border Background="#1A1A1A" BorderBrush="#2A2A2A"
                            BorderThickness="1" CornerRadius="8"
                            Padding="12,10" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="🔍"
                                       Foreground="#E8002D" FontSize="14"
                                       VerticalAlignment="Center"/>

                            <TextBox Grid.Column="1"
                                     x:Name="SearchBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="White"
                                     FontSize="13"
                                     CaretBrush="White"
                                     VerticalAlignment="Center"
                                     Margin="10,0"
                                     TextChanged="OnSearchTextChanged"
                                     Tag="Search by name or country..">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TextBox">
                                                    <Grid>
                                                        <TextBlock
                                                            Text="{TemplateBinding Tag}"
                                                            Foreground="#5A5A5A"
                                                            FontSize="13"
                                                            VerticalAlignment="Center"
                                                            Margin="2,0,0,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger
                                                                            Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}"
                                                                            Value="">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <ScrollViewer x:Name="PART_ContentHost"
                                                                      VerticalAlignment="Center"/>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>

                            <TextBlock Grid.Column="2" x:Name="LoadingSpinner"
                                       Text="⟳" Foreground="#E8002D"
                                       FontSize="16" VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <!-- Empty state -->
                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center"
                                Margin="0,60,0,0">
                        <TextBlock Text="🗺" FontSize="52"
                                   HorizontalAlignment="Center" Opacity="0.15"/>
                        <TextBlock Text="Start typing to explore the world's most demanding tracks."
                                   Foreground="#5A5A5A" FontSize="13"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   MaxWidth="260" Margin="0,12,0,0"/>
                    </StackPanel>

                    <!-- Liste résultats -->
                    <ItemsControl x:Name="CircuitsCollection" Visibility="Collapsed">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}"
                                        Margin="0,0,0,8" Cursor="Hand"
                                        MouseLeftButtonDown="OnCircuitSelected">
                                    <Grid Margin="14,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Background="#E8002D"
                                                Width="3" CornerRadius="2"
                                                Margin="0,0,12,0"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding circuitName}"
                                                       Foreground="White" FontSize="13"
                                                       FontWeight="Bold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="{Binding city}"
                                                           Foreground="#8A8A8A" FontSize="11"/>
                                                <TextBlock Text=", "
                                                           Foreground="#8A8A8A" FontSize="11"/>
                                                <TextBlock Text="{Binding country}"
                                                           Foreground="#8A8A8A" FontSize="11"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                                    HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding circuitLength, StringFormat='{}{0} m'}"
                                                       Foreground="#E8002D" FontSize="11"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Right"/>
                                            <TextBlock Text="›" Foreground="#5A5A5A"
                                                       FontSize="20"
                                                       HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Aucun résultat -->
                    <Border x:Name="NoResultPanel" Visibility="Collapsed"
                            Style="{StaticResource Card}" Margin="0,0,0,8">
                        <TextBlock Text="Aucun circuit trouvé."
                                   Foreground="#5A5A5A" FontSize="13"
                                   Margin="14,12" HorizontalAlignment="Center"/>
                    </Border>

                </StackPanel>

                <!-- ═══════════════════════════════════════════ -->
                <!--  PANNEAU DÉTAIL (caché au départ)           -->
                <!-- ═══════════════════════════════════════════ -->
                <StackPanel x:Name="PanelDetail" Visibility="Collapsed">

                    <!-- Bouton retour -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14"
                                Cursor="Hand" MouseLeftButtonDown="OnBackClicked">
                        <Border Background="#E8002D" CornerRadius="6"
                                Width="28" Height="28" Margin="0,0,10,0">
                            <TextBlock Text="←" Foreground="White" FontSize="14"
                                       FontWeight="Bold" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Retour aux circuits"
                                   Foreground="#8A8A8A" FontSize="13"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- HERO CARD -->
                    <Border CornerRadius="8" Height="190"
                            Margin="0,0,0,10" ClipToBounds="True">
                        <Grid>
                            <Border Background="#1A0000"/>
                            <Canvas>
                                <Ellipse Canvas.Left="-40" Canvas.Top="-40"
                                         Width="200" Height="200"
                                         Fill="#33E8002D"/>
                                <Ellipse Canvas.Left="250" Canvas.Top="80"
                                         Width="150" Height="150"
                                         Fill="#1AE8002D"/>
                            </Canvas>
                            <Border Background="#E8002D" CornerRadius="4"
                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Margin="14,14,0,0" Padding="8,4">
                                <TextBlock Text="ACTIVE CIRCUIT"
                                           Foreground="White" FontSize="9"
                                           FontWeight="Bold"/>
                            </Border>
                            <StackPanel VerticalAlignment="Bottom" Margin="14,0,14,14">
                                <TextBlock x:Name="HeroLocation"
                                           Foreground="#8A8A8A" FontSize="11"
                                           Margin="0,0,0,4"/>
                                <TextBlock x:Name="HeroName"
                                           Foreground="White" FontSize="22"
                                           FontWeight="Bold" TextWrapping="Wrap"
                                           Margin="0,0,0,10"/>
                                <Border Background="#E8002D" CornerRadius="20"
                                        HorizontalAlignment="Left" Padding="16,8"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="OnWikipediaClicked">
                                    <TextBlock Text="🌐  Open Wikipedia"
                                               Foreground="White" FontSize="12"
                                               FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- TRACK TELEMETRY -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel Margin="14">

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Ellipse Fill="#E8002D" Width="8" Height="8"
                                         VerticalAlignment="Center"/>
                                <TextBlock Text="TRACK TELEMETRY"
                                           Foreground="White" FontSize="11"
                                           FontWeight="Bold" Margin="8,0,0,0"/>
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Longueur -->
                                <Border Grid.Row="0" Grid.Column="0"
                                        Style="{StaticResource StatCard}">
                                    <StackPanel>
                                        <TextBlock Text="LONGUEUR"
                                                   Style="{StaticResource LabelCap}"
                                                   Margin="0,0,0,4"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="TxtLength"
                                                       Foreground="White" FontSize="22"
                                                       FontWeight="Bold"/>
                                            <TextBlock Text=" m" Foreground="#8A8A8A"
                                                       FontSize="12" VerticalAlignment="Bottom"
                                                       Margin="0,0,0,2"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Virages -->
                                <Border Grid.Row="0" Grid.Column="2"
                                        Style="{StaticResource StatCard}">
                                    <StackPanel>
                                        <TextBlock Text="VIRAGES"
                                                   Style="{StaticResource LabelCap}"
                                                   Margin="0,0,0,4"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="TxtCorners"
                                                       Foreground="White" FontSize="22"
                                                       FontWeight="Bold"/>
                                            <TextBlock Text=" turns" Foreground="#8A8A8A"
                                                       FontSize="12" VerticalAlignment="Bottom"
                                                       Margin="0,0,0,2"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Premier GP -->
                                <Border Grid.Row="2" Grid.Column="0"
                                        Style="{StaticResource StatCard}">
                                    <StackPanel>
                                        <TextBlock Text="PREMIER GP"
                                                   Style="{StaticResource LabelCap}"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock x:Name="TxtFirstYear"
                                                   Foreground="White" FontSize="22"
                                                   FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>

                                <!-- Lap Record -->
                                <Border Grid.Row="2" Grid.Column="2"
                                        Style="{StaticResource StatCard}">
                                    <StackPanel>
                                        <TextBlock Text="LAP RECORD"
                                                   Style="{StaticResource LabelCap}"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock x:Name="TxtLapRecord"
                                                   Foreground="#E8002D" FontSize="16"
                                                   FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>

                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- LAP RECORD DETAIL -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel Margin="14">

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="LAP RECORD"
                                           Foreground="White" FontSize="12"
                                           FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="🏆" FontSize="18"/>
                            </Grid>

                            <TextBlock x:Name="TxtLapRecordBig"
                                       Foreground="#E8002D" FontSize="34"
                                       FontWeight="Bold" FontStyle="Italic"
                                       Margin="0,0,0,4"/>

                            <TextBlock x:Name="TxtFastestDriver"
                                       Foreground="White" FontSize="14"
                                       FontWeight="Bold" Margin="0,0,0,2"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock x:Name="TxtFastestTeam"
                                           Foreground="#8A8A8A" FontSize="12"/>
                                <TextBlock Text=" • " Foreground="#8A8A8A" FontSize="12"/>
                                <TextBlock x:Name="TxtFastestYear"
                                           Foreground="#8A8A8A" FontSize="12"/>
                            </StackPanel>

                            <Border Style="{StaticResource Separator}"/>

                            <Grid Margin="0,6,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Longueur circuit"
                                           Foreground="#8A8A8A" FontSize="12"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock x:Name="TxtLengthDetail"
                                               Foreground="White" FontSize="12"
                                               FontWeight="Bold"/>
                                    <TextBlock Text=" m" Foreground="#8A8A8A" FontSize="12"/>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Nombre de virages"
                                           Foreground="#8A8A8A" FontSize="12"/>
                                <TextBlock x:Name="TxtCornersDetail"
                                           Grid.Column="1" Foreground="White"
                                           FontSize="12" FontWeight="Bold"/>
                            </Grid>

                        </StackPanel>
                    </Border>

                    <!-- HISTORIQUE -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel Margin="14">

                            <TextBlock Text="HISTORIQUE" Foreground="White"
                                       FontSize="12" FontWeight="Bold"
                                       Margin="0,0,0,12"/>

                            <StackPanel Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                    <Ellipse Fill="#E8002D" Width="7" Height="7"
                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="PREMIER GRAND PRIX"
                                               Style="{StaticResource LabelCap}"
                                               Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtHistoryYear"
                                           Foreground="White" FontSize="20"
                                           FontWeight="Bold" Margin="13,0,0,0"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                    <Ellipse Fill="#E8002D" Width="7" Height="7"
                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="PILOTE DU RECORD"
                                               Style="{StaticResource LabelCap}"
                                               Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtRecordDriver"
                                           Foreground="White" FontSize="16"
                                           FontWeight="Bold" Margin="13,0,0,0"/>
                            </StackPanel>

                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                    <Ellipse Fill="#E8002D" Width="7" Height="7"
                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="ÉCURIE DU RECORD"
                                               Style="{StaticResource LabelCap}"
                                               Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtRecordTeam"
                                           Foreground="White" FontSize="16"
                                           FontWeight="Bold" Margin="13,0,0,0"/>
                            </StackPanel>

                        </StackPanel>
                    </Border>

                    <!-- LOCALISATION -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel Margin="14">

                            <TextBlock Text="LOCALISATION" Foreground="White"
                                       FontSize="12" FontWeight="Bold"
                                       Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Ville"
                                           Foreground="#8A8A8A" FontSize="12"/>
                                <TextBlock x:Name="TxtCity" Grid.Column="1"
                                           Foreground="White" FontSize="12"
                                           FontWeight="Bold"/>
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Pays"
                                           Foreground="#8A8A8A" FontSize="12"/>
                                <TextBlock x:Name="TxtCountry" Grid.Column="1"
                                           Foreground="White" FontSize="12"
                                           FontWeight="Bold"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Année record"
                                           Foreground="#8A8A8A" FontSize="12"/>
                                <TextBlock x:Name="TxtRecordYear" Grid.Column="1"
                                           Foreground="#E8002D" FontSize="12"
                                           FontWeight="Bold"/>
                            </Grid>

                        </StackPanel>
                    </Border>

                </StackPanel>
                <!-- FIN PanelDetail -->

            </StackPanel>
        </ScrollViewer>

        <!-- ═══════════════════════════════════════════ -->
        <!--  BOTTOM NAV                                 -->
        <!-- ═══════════════════════════════════════════ -->
        <Border Grid.Row="1" Background="#111111"
                BorderBrush="#2A2A2A" BorderThickness="0,1,0,0">
            <Grid Margin="0,10,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" HorizontalAlignment="Center"
                            Cursor="Hand" MouseLeftButtonDown="Nav_Home_Click">
                    <TextBlock Text="🏠" FontSize="20" HorizontalAlignment="Center"/>
                    <TextBlock Text="Hub" Foreground="#5A5A5A" FontSize="9"
                               HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center"
                            Cursor="Hand" MouseLeftButtonDown="Nav_Pilotes_Click">
                    <TextBlock Text="👤" FontSize="20" HorizontalAlignment="Center"/>
                    <TextBlock Text="Pilotes" Foreground="#5A5A5A" FontSize="9"
                               HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <Border Background="#E8002D" CornerRadius="30"
                            HorizontalAlignment="Center" Margin="0,-22,0,0">
                        <TextBlock Text="🗺" FontSize="22" Margin="14,10"/>
                    </Border>
                    <TextBlock Text="Circuits" Foreground="#E8002D" FontSize="9"
                               FontWeight="Bold" HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="3" HorizontalAlignment="Center"
                            Cursor="Hand" MouseLeftButtonDown="Nav_Saison_Click">
                    <TextBlock Text="🏁" FontSize="20" HorizontalAlignment="Center"/>
                    <TextBlock Text="Saison" Foreground="#5A5A5A" FontSize="9"
                               HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="4" HorizontalAlignment="Center"
                            Cursor="Hand" MouseLeftButtonDown="Nav_Profil_Click">
                    <TextBlock Text="⚙" FontSize="20" HorizontalAlignment="Center"/>
                    <TextBlock Text="Profil" Foreground="#5A5A5A" FontSize="9"
                               HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>

            </Grid>
        </Border>

    </Grid>
</Window>