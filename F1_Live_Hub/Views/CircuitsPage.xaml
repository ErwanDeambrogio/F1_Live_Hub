<Window x:Class="F1_Live_Hub.Views.CircuitsPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Title="F1 Live Hub - Circuits"
        Height="900" Width="420"
        Background="#0A0A0A"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#141414"/>
            <Setter Property="BorderBrush" Value="#252525"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>

        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="#0F0F0F"/>
            <Setter Property="BorderBrush" Value="#222222"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>

        <Style x:Key="LabelCap" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#505050"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="Separator" TargetType="Border">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="0,8"/>
        </Style>

        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ═══ -->
        <Border Grid.Row="0"
                Background="#0F0F0F"
                BorderBrush="#1E1E1E"
                BorderThickness="0,0,0,1"
                Padding="16,14"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="8" Width="32" Height="32" Margin="0,0,10,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF0028" Offset="0"/>
                                <GradientStop Color="#CC0020" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="F1" Foreground="White" FontSize="12"
                                   FontWeight="Bold" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock VerticalAlignment="Center">
                        <Run Text="F1 " Foreground="White" FontSize="19" FontWeight="Bold"/>
                        <Run Text="LIVE " Foreground="#E8002D" FontSize="19" FontWeight="Bold"/>
                        <Run Text="HUB" Foreground="#888888" FontSize="19" FontWeight="Bold"/>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1C1C1C" CornerRadius="20"
                            Width="36" Height="36" Cursor="Hand" Margin="0,0,8,0">
                        <TextBlock Text="🔍" FontSize="14"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <Border Background="#1C1C1C" CornerRadius="20"
                            Width="36" Height="36" Cursor="Hand">
                        <Grid>
                            <TextBlock Text="🔔" FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            <Border Background="#E8002D" Width="7" Height="7"
                                    CornerRadius="4"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,4,4,0"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ TABS ═══ -->
        <Border Grid.Row="1"
                Background="#0F0F0F"
                BorderBrush="#1E1E1E"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource NavBtn}"
                        MouseLeftButtonDown="Tab_Classement_Click">
                    <StackPanel>
                        <TextBlock Text="CLASSEMENT" Foreground="#606060"
                                   FontSize="10" FontWeight="Bold"
                                   HorizontalAlignment="Center" Padding="0,11,0,8"/>
                        <Border Height="2" CornerRadius="1" Background="Transparent"/>
                    </StackPanel>
                </Button>

                <!-- Tab actif : CIRCUITS -->
                <StackPanel Grid.Column="1">
                    <TextBlock Text="CIRCUITS" Foreground="White"
                               FontSize="10" FontWeight="Bold"
                               HorizontalAlignment="Center" Padding="0,11,0,8"/>
                    <Border Height="2" CornerRadius="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FF0028" Offset="0"/>
                                <GradientStop Color="#E8002D" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </StackPanel>

                <Button Grid.Column="2" Style="{StaticResource NavBtn}"
                        MouseLeftButtonDown="Tab_Course_Click">
                    <StackPanel>
                        <TextBlock Text="COURSE" Foreground="#606060"
                                   FontSize="10" FontWeight="Bold"
                                   HorizontalAlignment="Center" Padding="0,11,0,8"/>
                        <Border Height="2" CornerRadius="1" Background="Transparent"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="3" Style="{StaticResource NavBtn}"
                        MouseLeftButtonDown="Tab_Meteo_Click">
                    <StackPanel>
                        <TextBlock Text="MÉTÉO" Foreground="#606060"
                                   FontSize="10" FontWeight="Bold"
                                   HorizontalAlignment="Center" Padding="0,11,0,8"/>
                        <Border Height="2" CornerRadius="1" Background="Transparent"/>
                    </StackPanel>
                </Button>

            </Grid>
        </Border>

        <!-- ═══ SCROLL CONTENT ═══ -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Hidden"
                      Background="#0A0A0A">
            <StackPanel Margin="12,14,12,14">

                <!-- ══ PANNEAU RECHERCHE ══ -->
                <StackPanel x:Name="PanelRecherche" Visibility="Visible">

                    <!-- Titre -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="CIRCUIT " Foreground="White"
                                   FontSize="26" FontWeight="Bold"/>
                        <TextBlock Text="TELEMETRY" Foreground="#E8002D"
                                   FontSize="26" FontWeight="Bold" FontStyle="Italic"/>
                    </StackPanel>

                    <!-- Barre de recherche -->
                    <Border Background="#141414"
                            BorderBrush="#252525"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14,11"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="🔍"
                                       Foreground="#E8002D" FontSize="14"
                                       VerticalAlignment="Center"/>

                            <TextBox Grid.Column="1"
                                     x:Name="SearchBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="White"
                                     FontSize="13"
                                     CaretBrush="White"
                                     VerticalAlignment="Center"
                                     Margin="10,0"
                                     TextChanged="OnSearchTextChanged"
                                     Tag="Rechercher un circuit ou un pays...">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TextBox">
                                                    <Grid>
                                                        <TextBlock
                                                            Text="{TemplateBinding Tag}"
                                                            Foreground="#404040"
                                                            FontSize="13"
                                                            VerticalAlignment="Center"
                                                            Margin="2,0,0,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger
                                                                            Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}"
                                                                            Value="">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <ScrollViewer x:Name="PART_ContentHost"
                                                                      VerticalAlignment="Center"/>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>

                            <TextBlock Grid.Column="2" x:Name="LoadingSpinner"
                                       Text="⟳" Foreground="#E8002D"
                                       FontSize="16" VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <!-- Empty state -->
                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center"
                                Margin="0,50,0,0">
                        <TextBlock Text="🗺" FontSize="48"
                                   HorizontalAlignment="Center" Opacity="0.1"/>
                        <TextBlock Text="Commence à taper pour explorer les circuits."
                                   Foreground="#404040" FontSize="12"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   MaxWidth="240" Margin="0,12,0,0"/>
                    </StackPanel>

                    <!-- Liste résultats -->
                    <ItemsControl x:Name="CircuitsCollection" Visibility="Collapsed">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}"
                                        Margin="0,0,0,8" Cursor="Hand"
                                        MouseLeftButtonDown="OnCircuitSelected">
                                    <Grid Margin="14,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Background="#E8002D"
                                                Width="3" CornerRadius="2"
                                                Margin="0,0,12,0"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding circuitName}"
                                                       Foreground="White" FontSize="13"
                                                       FontWeight="Bold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding city}"
                                                           Foreground="#505050" FontSize="11"/>
                                                <TextBlock Text=", "
                                                           Foreground="#505050" FontSize="11"/>
                                                <TextBlock Text="{Binding country}"
                                                           Foreground="#505050" FontSize="11"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                                    HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding circuitLength, StringFormat='{}{0} m'}"
                                                       Foreground="#E8002D" FontSize="11"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Right"/>
                                            <TextBlock Text="›" Foreground="#404040"
                                                       FontSize="20"
                                                       HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Aucun résultat -->
                    <Border x:Name="NoResultPanel" Visibility="Collapsed"
                            Style="{StaticResource Card}" Margin="0,0,0,8">
                        <TextBlock Text="Aucun circuit trouvé."
                                   Foreground="#505050" FontSize="13"
                                   Margin="14,12" HorizontalAlignment="Center"/>
                    </Border>

                </StackPanel>

                <!-- ══ PANNEAU DÉTAIL ══ -->
                <StackPanel x:Name="PanelDetail" Visibility="Collapsed">

                    <!-- Bouton retour -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16"
                                Cursor="Hand" MouseLeftButtonDown="OnBackClicked">
                        <Border CornerRadius="8" Width="30" Height="30" Margin="0,0,10,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#CC0020" Offset="0"/>
                                    <GradientStop Color="#E8002D" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="←" Foreground="White" FontSize="14"
                                       FontWeight="Bold" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Retour aux circuits"
                                   Foreground="#606060" FontSize="13"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- HERO CARD -->
                    <Border CornerRadius="14" Height="185"
                            Margin="0,0,0,12" ClipToBounds="True">
                        <Grid>
                            <!-- Fond -->
                            <Border>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#140808" Offset="0"/>
                                        <GradientStop Color="#200808" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <!-- Accent déco -->
                            <Border VerticalAlignment="Top" HorizontalAlignment="Left"
                                    Width="220" Height="3">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#E8002D" Offset="0"/>
                                        <GradientStop Color="Transparent" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <!-- Cercles déco -->
                            <Canvas>
                                <Ellipse Canvas.Left="-30" Canvas.Top="-30"
                                         Width="160" Height="160" Fill="#22E8002D"/>
                                <Ellipse Canvas.Left="260" Canvas.Top="80"
                                         Width="120" Height="120" Fill="#11E8002D"/>
                            </Canvas>

                            <!-- Badge -->
                            <Border Background="#E8002D" CornerRadius="4"
                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Margin="14,14,0,0" Padding="8,4">
                                <TextBlock Text="CIRCUIT ACTIF"
                                           Foreground="White" FontSize="8"
                                           FontWeight="Bold"/>
                            </Border>

                            <!-- Texte bas -->
                            <StackPanel VerticalAlignment="Bottom" Margin="14,0,14,14">
                                <TextBlock x:Name="HeroLocation"
                                           Foreground="#606060" FontSize="11"
                                           Margin="0,0,0,4"/>
                                <TextBlock x:Name="HeroName"
                                           Foreground="White" FontSize="20"
                                           FontWeight="Bold" TextWrapping="Wrap"
                                           Margin="0,0,0,12"/>
                                <Border CornerRadius="20"
                                        HorizontalAlignment="Left" Padding="16,8"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="OnWikipediaClicked">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#CC0020" Offset="0"/>
                                            <GradientStop Color="#E8002D" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock Text="🌐  Wikipedia"
                                               Foreground="White" FontSize="12"
                                               FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- TRACK TELEMETRY -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel Margin="14">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border Background="#E8002D" Width="3" Height="12"
                                        CornerRadius="2" Margin="0,0,8,0"
                                        VerticalAlignment="Center"/>
                                <TextBlock Text="TRACK TELEMETRY"
                                           Foreground="White" FontSize="11"
                                           FontWeight="Bold"/>
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Longueur -->
                                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource StatCard}">
                                    <StackPanel>
                                        <TextBlock Text="LONGUEUR" Style="{StaticResource LabelCap}"
                                                   Margin="0,0,0,6"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="TxtLength"
                                                       Foreground="White" FontSize="20"
                                                       FontWeight="Bold"/>
                                            <TextBlock Text=" m" Foreground="#505050"
                                                       FontSize="11" VerticalAlignment="Bottom"
                                                       Margin="2,0,0,2"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Virages -->
                                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource StatCard}">
                                    <StackPanel>
                                        <TextBlock Text="VIRAGES" Style="{StaticResource LabelCap}"
                                                   Margin="0,0,0,6"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="TxtCorners"
                                                       Foreground="White" FontSize="20"
                                                       FontWeight="Bold"/>
                                            <TextBlock Text=" turns" Foreground="#505050"
                                                       FontSize="11" VerticalAlignment="Bottom"
                                                       Margin="2,0,0,2"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Premier GP -->
                                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource StatCard}">
                                    <StackPanel>
                                        <TextBlock Text="PREMIER GP" Style="{StaticResource LabelCap}"
                                                   Margin="0,0,0,6"/>
                                        <TextBlock x:Name="TxtFirstYear"
                                                   Foreground="White" FontSize="20"
                                                   FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>

                                <!-- Lap Record -->
                                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource StatCard}">
                                    <StackPanel>
                                        <TextBlock Text="LAP RECORD" Style="{StaticResource LabelCap}"
                                                   Margin="0,0,0,6"/>
                                        <TextBlock x:Name="TxtLapRecord"
                                                   Foreground="#E8002D" FontSize="14"
                                                   FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- LAP RECORD DETAIL -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel Margin="14">
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Border Background="#E8002D" Width="3" Height="12"
                                            CornerRadius="2" Margin="0,0,8,0"/>
                                    <TextBlock Text="LAP RECORD" Foreground="White"
                                               FontSize="11" FontWeight="Bold"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="🏆" FontSize="16"/>
                            </Grid>

                            <TextBlock x:Name="TxtLapRecordBig"
                                       Foreground="#E8002D" FontSize="32"
                                       FontWeight="Bold" FontStyle="Italic"
                                       Margin="0,0,0,6"/>
                            <TextBlock x:Name="TxtFastestDriver"
                                       Foreground="White" FontSize="14"
                                       FontWeight="Bold" Margin="0,0,0,2"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock x:Name="TxtFastestTeam"
                                           Foreground="#505050" FontSize="12"/>
                                <TextBlock Text=" • " Foreground="#505050" FontSize="12"/>
                                <TextBlock x:Name="TxtFastestYear"
                                           Foreground="#505050" FontSize="12"/>
                            </StackPanel>

                            <Border Style="{StaticResource Separator}"/>

                            <Grid Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Longueur circuit"
                                           Foreground="#505050" FontSize="12"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock x:Name="TxtLengthDetail"
                                               Foreground="White" FontSize="12"
                                               FontWeight="Bold"/>
                                    <TextBlock Text=" m" Foreground="#505050" FontSize="12"/>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Nombre de virages"
                                           Foreground="#505050" FontSize="12"/>
                                <TextBlock x:Name="TxtCornersDetail"
                                           Grid.Column="1" Foreground="White"
                                           FontSize="12" FontWeight="Bold"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- HISTORIQUE -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel Margin="14">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border Background="#E8002D" Width="3" Height="12"
                                        CornerRadius="2" Margin="0,0,8,0"
                                        VerticalAlignment="Center"/>
                                <TextBlock Text="HISTORIQUE" Foreground="White"
                                           FontSize="11" FontWeight="Bold"/>
                            </StackPanel>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Premier Grand Prix"
                                           Foreground="#505050" FontSize="12"/>
                                <TextBlock x:Name="TxtHistoryYear"
                                           Grid.Column="1" Foreground="White"
                                           FontSize="12" FontWeight="Bold"/>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Pilote du record"
                                           Foreground="#505050" FontSize="12"/>
                                <TextBlock x:Name="TxtRecordDriver"
                                           Grid.Column="1" Foreground="White"
                                           FontSize="12" FontWeight="Bold"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Écurie du record"
                                           Foreground="#505050" FontSize="12"/>
                                <TextBlock x:Name="TxtRecordTeam"
                                           Grid.Column="1" Foreground="White"
                                           FontSize="12" FontWeight="Bold"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- LOCALISATION -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel Margin="14">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border Background="#E8002D" Width="3" Height="12"
                                        CornerRadius="2" Margin="0,0,8,0"
                                        VerticalAlignment="Center"/>
                                <TextBlock Text="LOCALISATION" Foreground="White"
                                           FontSize="11" FontWeight="Bold"/>
                            </StackPanel>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Ville"
                                           Foreground="#505050" FontSize="12"/>
                                <TextBlock x:Name="TxtCity" Grid.Column="1"
                                           Foreground="White" FontSize="12"
                                           FontWeight="Bold"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Pays"
                                           Foreground="#505050" FontSize="12"/>
                                <TextBlock x:Name="TxtCountry" Grid.Column="1"
                                           Foreground="White" FontSize="12"
                                           FontWeight="Bold"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Année record"
                                           Foreground="#505050" FontSize="12"/>
                                <TextBlock x:Name="TxtRecordYear" Grid.Column="1"
                                           Foreground="#E8002D" FontSize="12"
                                           FontWeight="Bold"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
                <!-- FIN PanelDetail -->

            </StackPanel>
        </ScrollViewer>

        <!-- ═══ BOTTOM NAV ═══ -->
        <Border Grid.Row="3"
                Background="#0F0F0F"
                BorderBrush="#1E1E1E"
                BorderThickness="0,1,0,0"
                Padding="0,10,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- HUB -->
                <StackPanel Grid.Column="0" HorizontalAlignment="Center"
                            Cursor="Hand" MouseLeftButtonDown="Nav_Home_Click">
                    <TextBlock Text="🏠" FontSize="20" HorizontalAlignment="Center"/>
                    <TextBlock Text="ACCUEIL" Foreground="White"
                               FontSize="7" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- PILOTES -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Center"
                            Cursor="Hand" MouseLeftButtonDown="Nav_Pilotes_Click">
                    <TextBlock Text="👤" FontSize="20" HorizontalAlignment="Center"/>
                    <TextBlock Text="PILOTES" Foreground="White"
                               FontSize="7" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- CIRCUITS (actif) -->
                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="🗺" FontSize="20" HorizontalAlignment="Center"/>
                    <TextBlock Text="CIRCUITS" Foreground="#E8002D"
                               FontSize="7" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    <Border Height="2" Width="20" CornerRadius="1"
                            HorizontalAlignment="Center" Margin="0,4,0,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#E8002D" Offset="0"/>
                                <GradientStop Color="#FF4455" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </StackPanel>

                <!-- SAISON -->
                <StackPanel Grid.Column="3" HorizontalAlignment="Center"
                            Cursor="Hand" MouseLeftButtonDown="Nav_Saison_Click">
                    <TextBlock Text="🏁" FontSize="20" HorizontalAlignment="Center"/>
                    <TextBlock Text="SAISON" Foreground="White"
                               FontSize="7" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- PROFIL -->
                <StackPanel Grid.Column="4" HorizontalAlignment="Center"
                            Cursor="Hand" MouseLeftButtonDown="Nav_Profil_Click">
                    <TextBlock Text="⚙" FontSize="20" HorizontalAlignment="Center"/>
                    <TextBlock Text="PROFIL" Foreground="White"
                               FontSize="7" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

            </Grid>
        </Border>

    </Grid>
</Window>