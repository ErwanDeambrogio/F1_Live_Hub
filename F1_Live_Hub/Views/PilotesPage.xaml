<Window x:Class="F1_Live_Hub.Views.PilotesPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        WindowStyle="None" AllowsTransparency="True"
        ResizeMode="NoResize" Title="F1 HUB - Pilotes"
        Height="900" Width="420"
        Background="#0D0D0D" WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!-- Scrollbar fine -->
        <Style x:Key="SlimScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Opacity="0" Height="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#444444" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Opacity="0" Height="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SlimScrollViewer" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="4"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0"/>
                            <ScrollBar Grid.Column="1"
                                       x:Name="PART_VerticalScrollBar"
                                       Style="{StaticResource SlimScrollBar}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Grid Grid.Row="0" Height="56" Margin="16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="22" Height="22" Background="#E10600"
                        CornerRadius="4" Margin="0,0,6,0">
                    <TextBlock Text="F1" Foreground="White" FontSize="9" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="F1 HUB" Foreground="White" FontSize="16"
                           FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Grid.Column="2" Text="🔔" FontSize="18"
                       Foreground="White" VerticalAlignment="Center"/>
        </Grid>

        <!-- NAV TABS -->
        <Grid Grid.Row="1" Height="40" Margin="16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Classement" Foreground="#888888"
                       FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Cursor="Hand" MouseLeftButtonDown="Tab_Classement_Click"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Pilotes" Foreground="#E10600" FontSize="12"
                           FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <Rectangle Height="2" Fill="#E10600" Width="46" Margin="0,4,0,0"/>
            </StackPanel>
            <TextBlock Grid.Column="2" Text="Course" Foreground="#888888"
                       FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Cursor="Hand" MouseLeftButtonDown="Tab_Course_Click"/>
            <TextBlock Grid.Column="3" Text="Météo" Foreground="#888888"
                       FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Cursor="Hand" MouseLeftButtonDown="Tab_Circuits_Click"/>
        </Grid>

        <!-- RECHERCHE + FILTRE FAVORIS -->
        <Grid Grid.Row="2" Margin="16,8,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#1A1A1A" CornerRadius="10" Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🔍" FontSize="14"
                               Foreground="#888888" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1" x:Name="TxtSearch"
                             Background="Transparent" Foreground="White" FontSize="13"
                             BorderThickness="0" Padding="0,6" CaretBrush="White"
                             TextChanged="TxtSearch_TextChanged"/>
                </Grid>
            </Border>

            <Button Grid.Column="2" x:Name="BtnFavFilter"
                    Click="BtnFavFilter_Click" Cursor="Hand"
                    Content="★ Favoris (0) ▼">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BdFav" Background="#1A1A1A" CornerRadius="10"
                                Padding="10,8" BorderBrush="#333333" BorderThickness="1">
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="#FFD700" FontSize="11" FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BdFav" Property="Background" Value="#2A2500"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- STATUS LISTE -->
        <TextBlock Grid.Row="3" x:Name="TxtStatus" Foreground="#888888" FontSize="11"
                   HorizontalAlignment="Center" Margin="0,6,0,0" Visibility="Collapsed"/>

        <!-- BANNIÈRE FAVORIS ACTIF -->
        <Border Grid.Row="4" x:Name="FavBanner" Margin="16,4,16,0"
                Background="#1A1400" CornerRadius="8" Padding="10,5"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="★ " Foreground="#FFD700" FontSize="11" FontWeight="Bold"/>
                <TextBlock Text="Favoris uniquement" Foreground="#FFD700"
                           FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- CONTENU -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LISTE PILOTES -->
            <ListBox Grid.Column="0" x:Name="DriversList"
                     Background="Transparent" BorderThickness="0"
                     SelectionChanged="DriversList_SelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Hidden"
                     Margin="0,6,0,80">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="8,2,4,2"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" CornerRadius="8" Padding="8,7"
                                            Background="Transparent">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#2A0808"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#1A1A1A"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                            </Grid.ColumnDefinitions>

                            <!-- Logo écurie fond blanc -->
                            <Border Grid.Column="0" Width="30" Height="30"
                                    CornerRadius="6" Background="White">
                                <Grid>
                                    <Image Source="{Binding TeamLogoUrl}"
                                           Width="24" Height="24" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TeamLogoUrl}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                    <Border CornerRadius="6" Width="30" Height="30"
                                            Background="{Binding TeamColor}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TeamLogoUrl}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding ShortName}"
                                                   Foreground="White" FontSize="7" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                                <TextBlock Text="{Binding Name}" Foreground="White"
                                           FontSize="11" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Surname}" Foreground="#AAAAAA" FontSize="10"/>
                            </StackPanel>

                            <!-- Étoile favori -->
                            <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                       HorizontalAlignment="Center" FontSize="10">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value=""/>
                                        <Setter Property="Foreground" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                <Setter Property="Text" Value="★"/>
                                                <Setter Property="Foreground" Value="#FFD700"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- DETAIL PILOTE -->
            <ScrollViewer Grid.Column="1"
                          Style="{StaticResource SlimScrollViewer}"
                          VerticalScrollBarVisibility="Auto"
                          Margin="0,6,0,80">
                <StackPanel Margin="4,0,10,0">

                    <TextBlock x:Name="TxtDetailStatus" Foreground="#888888"
                               FontSize="11" HorizontalAlignment="Center"
                               Margin="0,20,0,0" Visibility="Collapsed"/>

                    <StackPanel x:Name="DetailPanel" Visibility="Collapsed">

                        <!-- HERO CARD -->
                        <Border Background="{Binding TeamColor}" CornerRadius="12"
                                Height="150" Margin="0,0,0,8" ClipToBounds="True">
                            <Grid>
                                <!-- Dégradé -->
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#00000000" Offset="0.4"/>
                                            <GradientStop Color="#55000000" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>

                                <!-- Photo pilote -->
                                <Image Source="{Binding PhotoUrl}"
                                   HorizontalAlignment="Right" VerticalAlignment="Top"
                                   Width="115" Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PhotoUrl}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>

                                <!-- Numéro filigrane -->
                                <TextBlock Text="{Binding Number, StringFormat='#{0}'}"
                                           Foreground="#FFFFFF12" FontSize="65" FontWeight="Bold"
                                           FontStyle="Italic" HorizontalAlignment="Right"
                                           VerticalAlignment="Bottom" Margin="0,0,4,0"/>

                                <!-- Infos gauche -->
                                <StackPanel VerticalAlignment="Center" Margin="14,0,120,0">
                                    <Border Background="White" CornerRadius="6"
                                            Padding="4,3" HorizontalAlignment="Left"
                                            Margin="0,0,0,6" MaxWidth="100">
                                        <Image Source="{Binding TeamLogoUrl}" Height="16"
                                               Stretch="Uniform" HorizontalAlignment="Left"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="#FFFFFFCC" FontSize="12"/>
                                    <TextBlock Text="{Binding Surname}" Foreground="White"
                                               FontSize="20" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding TeamName}"
                                               Foreground="#FFFFFFAA" FontSize="10" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- BOUTON FAVORIS -->
                        <Button x:Name="BtnFavDetail"
                                Click="BtnFavorite_Click"
                                Cursor="Hand"
                                Margin="0,0,0,8"
                                Content="☆ Ajouter aux favoris"
                                Tag="inactive">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#1A1A1A" CornerRadius="10"
                                            BorderBrush="#333333" BorderThickness="1"
                                            Padding="12,9">
                                        <Grid>
                                            <TextBlock Text="{TemplateBinding Content}"
                                                       FontSize="12" FontWeight="Bold"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Left">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#888888"/>
                                                        <Style.Triggers>
                                                            <DataTrigger
                                                                Binding="{Binding Tag,
                                                                    RelativeSource={RelativeSource
                                                                        AncestorType=Button}}"
                                                                Value="active">
                                                                <Setter Property="Foreground" Value="#FFD700"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- CHAMPIONNAT PILOTES -->
                        <Border Background="#1A1A1A" CornerRadius="10"
                                Padding="12,10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="CHAMPIONNAT PILOTES" Foreground="#888888"
                                           FontSize="8" FontWeight="Bold" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#111111"
                                            CornerRadius="8" Padding="8,8">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="POSITION" Foreground="#555555"
                                                       FontSize="8" FontWeight="Bold"
                                                       HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding ChampionshipPosition, StringFormat='P{0}'}"
                                                       Foreground="{Binding ChampionshipPositionColor}"
                                                       FontSize="22" FontWeight="Bold"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Background="#111111"
                                            CornerRadius="8" Padding="8,8">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="POINTS" Foreground="#555555"
                                                       FontSize="8" FontWeight="Bold"
                                                       HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding ChampionshipPoints}"
                                                       Foreground="White" FontSize="22" FontWeight="Bold"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="4" Background="#111111"
                                            CornerRadius="8" Padding="8,8">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="VICTOIRES" Foreground="#555555"
                                                       FontSize="8" FontWeight="Bold"
                                                       HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding ChampionshipWins}"
                                                       Foreground="White" FontSize="22" FontWeight="Bold"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- CHAMPIONNAT CONSTRUCTEURS -->
                        <Border Background="#1A1A1A" CornerRadius="10"
                                Padding="12,10" Margin="0,0,0,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="CONSTRUCTEURS"
                                               Foreground="#888888" FontSize="8" FontWeight="Bold"
                                               VerticalAlignment="Center"/>
                                    <Border Background="{Binding TeamColor}" CornerRadius="4"
                                            Padding="5,2" Margin="6,0,0,0">
                                        <TextBlock Text="{Binding TeamName}" Foreground="White"
                                                   FontSize="8" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#111111"
                                            CornerRadius="8" Padding="8,8">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="POSITION" Foreground="#555555"
                                                       FontSize="8" FontWeight="Bold"
                                                       HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding ConstructorPosition, StringFormat='P{0}'}"
                                                       Foreground="{Binding TeamColor}"
                                                       FontSize="22" FontWeight="Bold"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Background="#111111"
                                            CornerRadius="8" Padding="8,8">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="POINTS" Foreground="#555555"
                                                       FontSize="8" FontWeight="Bold"
                                                       HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding ConstructorPoints}"
                                                       Foreground="White" FontSize="22" FontWeight="Bold"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="4" Background="#111111"
                                            CornerRadius="8" Padding="8,8">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="VICTOIRES" Foreground="#555555"
                                                       FontSize="8" FontWeight="Bold"
                                                       HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding ConstructorWins}"
                                                       Foreground="White" FontSize="22" FontWeight="Bold"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- STATS 4 CASES -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="4"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Grid.Column="0" Background="#1A1A1A"
                                    CornerRadius="10" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="🏆 VICTOIRES" Foreground="#888888"
                                               FontSize="8" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding Wins}" Foreground="#E10600"
                                               FontSize="26" FontWeight="Bold"/>
                                    <TextBlock Text="cette saison" Foreground="#555555" FontSize="9"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="2" Background="#1A1A1A"
                                    CornerRadius="10" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="🥇 PODIUMS" Foreground="#888888"
                                               FontSize="8" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding Podiums}" Foreground="White"
                                               FontSize="26" FontWeight="Bold"/>
                                    <TextBlock Text="cette saison" Foreground="#555555" FontSize="9"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="0" Background="#1A1A1A"
                                    CornerRadius="10" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="📊 POINTS" Foreground="#888888"
                                               FontSize="8" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding TotalPoints}" Foreground="White"
                                               FontSize="26" FontWeight="Bold"/>
                                    <TextBlock Text="cette saison" Foreground="#555555" FontSize="9"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="2" Background="#1A1A1A"
                                    CornerRadius="10" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="🏁 COURSES" Foreground="#888888"
                                               FontSize="8" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding RacesEntered}" Foreground="White"
                                               FontSize="26" FontWeight="Bold"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Meilleur: P" Foreground="#555555" FontSize="9"/>
                                        <TextBlock Text="{Binding BestFinish}" Foreground="#E10600"
                                                   FontSize="9" FontWeight="Bold"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- INFOS PILOTE -->
                        <Border Background="#1A1A1A" CornerRadius="10"
                                Padding="12,10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="INFOS PILOTE" Foreground="#888888"
                                           FontSize="8" FontWeight="Bold" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Nationalité" Foreground="#555555" FontSize="11"/>
                                    <TextBlock Text="{Binding Nationality}" Foreground="White"
                                               FontSize="11" HorizontalAlignment="Right"/>
                                </Grid>
                                <Rectangle Height="1" Fill="#2A2A2A" Margin="0,2,0,6"/>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Date de naissance" Foreground="#555555" FontSize="11"/>
                                    <TextBlock Text="{Binding Birthday}" Foreground="White"
                                               FontSize="11" HorizontalAlignment="Right"/>
                                </Grid>
                                <Rectangle Height="1" Fill="#2A2A2A" Margin="0,2,0,6"/>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Numéro" Foreground="#555555" FontSize="11"/>
                                    <TextBlock Text="{Binding Number, StringFormat='#{0}'}"
                                               Foreground="#E10600" FontSize="11" FontWeight="Bold"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                                <Rectangle Height="1" Fill="#2A2A2A" Margin="0,2,0,6"/>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Équipe" Foreground="#555555" FontSize="11"/>
                                    <TextBlock Text="{Binding TeamName}" Foreground="White"
                                               FontSize="11" HorizontalAlignment="Right"
                                               TextWrapping="Wrap"/>
                                </Grid>
                                <Rectangle Height="1" Fill="#2A2A2A" Margin="0,2,0,6"/>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Nationalité équipe" Foreground="#555555" FontSize="11"/>
                                    <TextBlock Text="{Binding TeamNationality}" Foreground="White"
                                               FontSize="11" HorizontalAlignment="Right"/>
                                </Grid>
                                <Rectangle Height="1" Fill="#2A2A2A" Margin="0,2,0,6"/>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Titres constructeurs" Foreground="#555555" FontSize="11"/>
                                    <TextBlock Text="{Binding ConstructorsChampionships}"
                                               Foreground="White" FontSize="11"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                                <Rectangle Height="1" Fill="#2A2A2A" Margin="0,2,0,6"/>
                                <Grid>
                                    <TextBlock Text="Abandons" Foreground="#555555" FontSize="11"/>
                                    <TextBlock Text="{Binding Retirements}" Foreground="#888888"
                                               FontSize="11" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- WIKIPEDIA -->
                        <Button Click="BtnWikipedia_Click" Cursor="Hand" Margin="0,0,0,8">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#1A1A1A" CornerRadius="10"
                                            BorderBrush="#333333" BorderThickness="1"
                                            Padding="12,10">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="🌐" FontSize="14" Margin="0,0,8,0"/>
                                                <TextBlock Text="Voir sur Wikipedia"
                                                           Foreground="White" FontSize="12"
                                                           FontWeight="Bold"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="→" Foreground="#E10600"
                                                       FontSize="14" FontWeight="Bold"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- RÉSULTATS -->
                        <TextBlock Text="RÉSULTATS CETTE SAISON" Foreground="#888888"
                                   FontSize="8" FontWeight="Bold" Margin="0,0,0,6"/>

                        <ItemsControl x:Name="ResultsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1A1A1A" CornerRadius="8"
                                            Padding="10,8" Margin="0,0,0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Width="28" Height="28"
                                                    CornerRadius="6">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#2A2A2A"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding FinishingPosition}" Value="1">
                                                                <Setter Property="Background" Value="#E10600"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding FinishingPosition}" Value="2">
                                                                <Setter Property="Background" Value="#444444"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding FinishingPosition}" Value="3">
                                                                <Setter Property="Background" Value="#7A4A00"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Retired}" Value="True">
                                                                <Setter Property="Background" Value="#3A0000"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding PositionLabel}"
                                                           Foreground="White" FontSize="9"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center" Margin="8,0">
                                                <TextBlock Text="{Binding RaceName}"
                                                           Foreground="White" FontSize="11"
                                                           FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Country}"
                                                               Foreground="#888888" FontSize="10"/>
                                                    <TextBlock Text="  ·  "
                                                               Foreground="#444444" FontSize="10"/>
                                                    <TextBlock Text="{Binding RaceDate}"
                                                               Foreground="#555555" FontSize="10"/>
                                                </StackPanel>
                                                <TextBlock Foreground="#FFD700"
                                                           FontSize="9" Margin="0,1,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SprintPosition}" Value="0">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <Run Text="Sprint: P"/>
                                                    <Run Text="{Binding SprintPosition}"/>
                                                    <Run Text=" (+"/>
                                                    <Run Text="{Binding SprintPoints}"/>
                                                    <Run Text=" pts)"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PointsObtained, StringFormat='+{0} pts'}"
                                                           Foreground="#00C851" FontSize="11"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding GridPosition, StringFormat='Grille: {0}'}"
                                                           Foreground="#555555" FontSize="9"
                                                           HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding RaceTime}"
                                                           Foreground="#444444" FontSize="9"
                                                           HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Rectangle Height="10"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- BOTTOM NAV BAR -->
        <Border Grid.Row="6" Background="#111111" Height="70"
                BorderThickness="0,1,0,0" BorderBrush="#222222">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Cursor="Hand" MouseLeftButtonDown="Nav_Hub_Click">
                    <TextBlock Text="⌂" Foreground="#555555" FontSize="20"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="HUB" Foreground="#555555" FontSize="10"
                               FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <TextBlock Text="👤" FontSize="20" HorizontalAlignment="Center"/>
                    <TextBlock Text="PILOTES" Foreground="#E10600" FontSize="10"
                               FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
                <Border Grid.Column="2" VerticalAlignment="Top"
                        HorizontalAlignment="Center" Width="56" Height="56"
                        CornerRadius="28" Background="#E10600"
                        Margin="0,-20,0,0" Cursor="Hand"
                        MouseLeftButtonDown="Nav_Live_Click">
                    <TextBlock Text="⏱" FontSize="22" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="3" VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Cursor="Hand" MouseLeftButtonDown="Nav_Saison_Click">
                    <TextBlock Text="🏁" FontSize="20" HorizontalAlignment="Center"/>
                    <TextBlock Text="SAISON" Foreground="#555555" FontSize="10"
                               FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="4" VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Cursor="Hand" MouseLeftButtonDown="Nav_Profil_Click">
                    <TextBlock Text="⚙" Foreground="#555555" FontSize="20"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="PROFIL" Foreground="#555555" FontSize="10"
                               FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>