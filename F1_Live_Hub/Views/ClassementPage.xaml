                        <TextBlock Grid.Column="4" Text="-413 pts" Foreground="#8A8A8A" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,10"/>
                    </Grid>
                </Border>

