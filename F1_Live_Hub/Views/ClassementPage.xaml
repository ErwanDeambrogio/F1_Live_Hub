<Window x:Class="F1_Live_Hub.Views.ClassementPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        WindowStyle="None" AllowsTransparency="True"
        ResizeMode="NoResize"
        Title="F1 Live Hub - Classement" Height="900" Width="420"
        Background="#0A0A0A" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ═══ -->
        <Border Grid.Row="0" Background="#0F0F0F"
                BorderBrush="#1E1E1E" BorderThickness="0,0,0,1"
                Padding="16,14" MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="8" Width="32" Height="32" Margin="0,0,10,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF0028" Offset="0"/>
                                <GradientStop Color="#CC0020" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="F1" Foreground="White" FontSize="12" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock VerticalAlignment="Center">
                        <Run Text="F1 " Foreground="White" FontSize="19" FontWeight="Bold"/>
                        <Run Text="LIVE " Foreground="#E8002D" FontSize="19" FontWeight="Bold"/>
                        <Run Text="HUB" Foreground="#888888" FontSize="19" FontWeight="Bold"/>
                    </TextBlock>
                </StackPanel>
                <Border Grid.Column="1" Background="#1C1C1C" CornerRadius="20"
                        Width="36" Height="36" Cursor="Hand">
                    <TextBlock Text="🔍" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- ═══ TABS ═══ -->
        <Border Grid.Row="1" Background="#0F0F0F"
                BorderBrush="#1E1E1E" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Cursor="Hand" MouseLeftButtonDown="Tab_Accueil_Click">
                    <TextBlock Text="ACCUEIL" Foreground="#606060" FontSize="10" FontWeight="Bold"
                               HorizontalAlignment="Center" Padding="0,11,0,8"/>
                    <Border Height="2" CornerRadius="1" Background="Transparent"/>
                </StackPanel>

                <!-- CLASSEMENT actif -->
                <StackPanel Grid.Column="1">
                    <TextBlock Text="CLASSEMENT" Foreground="White" FontSize="10" FontWeight="Bold"
                               HorizontalAlignment="Center" Padding="0,11,0,8"/>
                    <Border Height="2" CornerRadius="1" Background="#E8002D"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Cursor="Hand" MouseLeftButtonDown="Tab_Pilotes_Click">
                    <TextBlock Text="PILOTES" Foreground="#606060" FontSize="10" FontWeight="Bold"
                               HorizontalAlignment="Center" Padding="0,11,0,8"/>
                    <Border Height="2" CornerRadius="1" Background="Transparent"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Cursor="Hand" MouseLeftButtonDown="Tab_Course_Click">
                    <TextBlock Text="COURSE" Foreground="#606060" FontSize="10" FontWeight="Bold"
                               HorizontalAlignment="Center" Padding="0,11,0,8"/>
                    <Border Height="2" CornerRadius="1" Background="Transparent"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ FILTRES ═══ -->
        <Border Grid.Row="2" Background="#0F0F0F"
                BorderBrush="#1E1E1E" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="14,8">
                <Border Background="#1A1A1A" BorderBrush="#333333" BorderThickness="1"
                        CornerRadius="6" Margin="0,0,8,0" Cursor="Hand"
                        MouseLeftButtonDown="BtnAnnee_Click">
                    <StackPanel Orientation="Horizontal" Margin="10,5">
                        <TextBlock Text="2024" Foreground="White" FontSize="12"
                                   FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text=" ▾" Foreground="#8A8A8A" FontSize="10" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Background="#1A1A1A" BorderBrush="#333333" BorderThickness="1"
                        CornerRadius="6" Margin="0,0,8,0" Cursor="Hand"
                        MouseLeftButtonDown="BtnGP_Click">
                    <StackPanel Orientation="Horizontal" Margin="10,5">
                        <Ellipse Fill="#E8002D" Width="7" Height="7"
                                 VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Monaco GP" Foreground="White" FontSize="12"
                                   FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text=" ▾" Foreground="#8A8A8A" FontSize="10" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Background="#1A1A1A" BorderBrush="#333333" BorderThickness="1"
                        CornerRadius="6" Cursor="Hand" MouseLeftButtonDown="BtnSession_Click">
                    <StackPanel Orientation="Horizontal" Margin="10,5">
                        <TextBlock Text="Qualifying" Foreground="White" FontSize="12"
                                   FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text=" ▾" Foreground="#8A8A8A" FontSize="10" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ═══ LIVE SESSION BAR ═══ -->
        <Border Grid.Row="3" Background="#1A1A1A"
                BorderBrush="#1E1E1E" BorderThickness="0,0,0,1">
            <Grid Margin="14,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Fill="#E8002D" Width="7" Height="7"
                             VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="LIVE SESSION" Foreground="White"
                               FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Foreground="#8A8A8A" FontSize="10"
                           FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Run Text="LAP "/><Run Text="52" Foreground="White"/><Run Text=" / 78"/>
                </TextBlock>
                <TextBlock Grid.Column="2" Foreground="#8A8A8A" FontSize="10"
                           FontWeight="Bold" VerticalAlignment="Center">
                    <Run Text="TRACK TEMP: "/><Run Text="42°C" Foreground="White"/>
                </TextBlock>
            </Grid>
        </Border>

        <!-- ═══ HEADER COLONNES ═══ -->
        <Border Grid.Row="4" Background="#0A0A0A">
            <Grid Margin="22,6,12,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="55"/>
                    <ColumnDefinition Width="75"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="POS" Foreground="#5A5A5A" FontSize="9" FontWeight="Bold"/>
                <TextBlock Grid.Column="2" Text="PILOTE / ÉQUIPE" Foreground="#5A5A5A"
                           FontSize="9" FontWeight="Bold" Margin="4,0,0,0"/>
                <TextBlock Grid.Column="3" Text="PTS" Foreground="#5A5A5A"
                           FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="4" Text="ÉCART" Foreground="#5A5A5A"
                           FontSize="9" FontWeight="Bold" HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- ═══ LISTE PILOTES ═══ -->
        <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto" Background="#0A0A0A">
            <StackPanel Margin="12,0,12,12">

                <Border Style="{StaticResource Card}" Margin="0,6,0,0">
                    <Grid Margin="0,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="38"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="55"/>
                            <ColumnDefinition Width="75"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#3B6FE8" Width="3" CornerRadius="2" HorizontalAlignment="Left" Margin="0,8,0,8"/>
                        <TextBlock Grid.Column="1" Text="01" Foreground="#E8002D" FontSize="18" FontWeight="Bold" FontStyle="Italic" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,10"/>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,10,0,10">
                            <TextBlock Text="M. VERSTAPPEN" Foreground="White" FontSize="13" FontWeight="Bold"/>
                            <TextBlock Text="Red Bull Racing" Foreground="#8A8A8A" FontSize="10" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="3" Text="575" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10"/>
                        <TextBlock Grid.Column="4" Text="LEADER" Foreground="#E8002D" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,10"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,6,0,0">
                    <Grid Margin="0,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="38"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="55"/>
                            <ColumnDefinition Width="75"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#3B6FE8" Width="3" CornerRadius="2" HorizontalAlignment="Left" Margin="0,8,0,8"/>
                        <TextBlock Grid.Column="1" Text="02" Foreground="#8A8A8A" FontSize="16" FontWeight="Bold" FontStyle="Italic" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,10"/>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,10,0,10">
                            <TextBlock Text="S. PÉREZ" Foreground="White" FontSize="13" FontWeight="Bold"/>
                            <TextBlock Text="Red Bull Racing" Foreground="#8A8A8A" FontSize="10" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="3" Text="285" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10"/>
