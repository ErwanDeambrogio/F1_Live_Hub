<Window x:Class="F1_Live_Hub.Views.ClassementPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:F1_Live_Hub.Views"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Title="F1 Live Hub - Classement" Height="900" Width="420"
        Background="#0D0D0D" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>
        <Style x:Key="NavText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5A5A5A"/>
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ HEADER ══ -->
        <Border Grid.Row="0" Background="#111111"
                BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
            <Grid Margin="14,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="8">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#E8002D" Offset="0"/>
                                <GradientStop Color="#A0001F" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="F1" Foreground="White" FontSize="11"
                                   FontWeight="Black" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock VerticalAlignment="Center" Margin="8,0,0,0"
                               FontWeight="Black" FontSize="17">
                        <Run Text="F1 " Foreground="White"/>
                        <Run Text="LIVE " Foreground="#E8002D"/>
                        <Run Text="HUB" Foreground="White"/>
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Border Background="#1A1A1A" CornerRadius="20"
                            Width="34" Height="34" Margin="0,0,8,0" Cursor="Hand">
                        <TextBlock Text="🔔" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Background="#2A2A2A" CornerRadius="20"
                            Width="34" Height="34" Cursor="Hand">
                        <TextBlock Text="👤" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ FILTRES ══ -->
        <Border Grid.Row="1" Background="#111111"
                BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="14,8">
                <Border Background="#1A1A1A" BorderBrush="#333333"
                        BorderThickness="1" CornerRadius="6" Margin="0,0,8,0"
                        Cursor="Hand" MouseLeftButtonDown="BtnAnnee_Click">
                    <StackPanel Orientation="Horizontal" Margin="10,5">
                        <TextBlock Text="2025" Foreground="White"
                                   FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text=" ▾" Foreground="#8A8A8A"
                                   FontSize="10" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Background="#1A1A1A" BorderBrush="#333333"
                        BorderThickness="1" CornerRadius="6" Margin="0,0,8,0"
                        Cursor="Hand" MouseLeftButtonDown="BtnGP_Click">
                    <StackPanel Orientation="Horizontal" Margin="10,5">
                        <Ellipse Fill="#E8002D" Width="7" Height="7"
                                 VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Monaco GP" Foreground="White"
                                   FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text=" ▾" Foreground="#8A8A8A"
                                   FontSize="10" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Background="#1A1A1A" BorderBrush="#333333"
                        BorderThickness="1" CornerRadius="6"
                        Cursor="Hand" MouseLeftButtonDown="BtnSession_Click">
                    <StackPanel Orientation="Horizontal" Margin="10,5">
                        <TextBlock Text="Qualifying" Foreground="White"
                                   FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text=" ▾" Foreground="#8A8A8A"
                                   FontSize="10" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ══ TABS ══ -->
        <Border Grid.Row="2" Background="#111111"
                BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Classement" Foreground="White" FontSize="12"
                               FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,8"/>
                    <Border Height="2" CornerRadius="1" Margin="8,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#E8002D" Offset="0"/>
                                <GradientStop Color="#FF6B6B" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Cursor="Hand"
                            MouseLeftButtonDown="Tab_Pilotes_Click">
                    <TextBlock Text="Pilotes" Foreground="#5A5A5A" FontSize="12"
                               FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,10"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Cursor="Hand"
                            MouseLeftButtonDown="Tab_Course_Click">
                    <TextBlock Text="Course" Foreground="#5A5A5A" FontSize="12"
                               FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,10"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Cursor="Hand">
                    <TextBlock Text="Météo" Foreground="#5A5A5A" FontSize="12"
                               FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,10"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ LIVE SESSION BAR ══ -->
        <Border Grid.Row="3" Background="#1A1A1A"
                BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
            <Grid Margin="14,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Fill="#E8002D" Width="8" Height="8"
                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="LIVE SESSION" Foreground="White"
                               FontSize="10" FontWeight="Black" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Foreground="#8A8A8A" FontSize="10"
                           FontWeight="Bold" VerticalAlignment="Center"
                           HorizontalAlignment="Center">
                    <Run Text="LAP "/>
                    <Run Text="52" Foreground="White" FontWeight="Black"/>
                    <Run Text=" / 78"/>
                </TextBlock>
                <TextBlock Grid.Column="2" Foreground="#8A8A8A" FontSize="10"
                           FontWeight="Bold" VerticalAlignment="Center">
                    <Run Text="TRACK TEMP: "/>
                    <Run Text="42°C" Foreground="White" FontWeight="Black"/>
                </TextBlock>
            </Grid>
        </Border>

        <!-- ══ HEADER COLONNES ══ -->
        <Border Grid.Row="4" Background="#0D0D0D">
            <Grid Margin="20,6,14,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="POS" Foreground="#5A5A5A"
                           FontSize="9" FontWeight="Bold"/>
                <TextBlock Grid.Column="1" Text="DRIVER / TEAM" Foreground="#5A5A5A"
                           FontSize="9" FontWeight="Bold" Margin="4,0,0,0"/>
                <TextBlock Grid.Column="2" Text="PTS" Foreground="#5A5A5A"
                           FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="INTERVAL" Foreground="#5A5A5A"
                           FontSize="9" FontWeight="Bold" HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- ══ LISTE 22 PILOTES ══ -->
        <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto" Background="#0D0D0D">
            <ItemsControl x:Name="ListeClassement" Margin="10,0,10,10">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,5,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5"/>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="10"/>
                                </Grid.ColumnDefinitions>

                                <!-- Barre couleur équipe -->
                                <Border Grid.Column="0"
                                        Background="{Binding CouleurEquipe}"
                                        Width="4" CornerRadius="3,0,0,3"
                                        HorizontalAlignment="Left"/>

                                <!-- Position -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Position}"
                                           Foreground="{Binding CouleurPosition}"
                                           FontSize="22" FontWeight="Black"
                                           FontStyle="Italic"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Margin="0,12,0,12"/>

                                <!-- Nom + Équipe -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                            Margin="4,12,0,12">
                                    <TextBlock Text="{Binding NomAffiche}"
                                               Foreground="White"
                                               FontSize="14" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding NomEquipe}"
                                               Foreground="#5A5A5A"
                                               FontSize="10" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Points -->
                                <StackPanel Grid.Column="3" HorizontalAlignment="Center"
                                            VerticalAlignment="Center" Margin="0,12,0,12">
                                    <TextBlock Text="{Binding Points}"
                                               Foreground="White"
                                               FontSize="15" FontWeight="Black"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="PTS" Foreground="#5A5A5A"
                                               FontSize="8" FontWeight="Bold"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>

                                <!-- Écart -->
                                <StackPanel Grid.Column="4" HorizontalAlignment="Right"
                                            VerticalAlignment="Center" Margin="0,12,0,12">
                                    <TextBlock Text="{Binding Ecart}"
                                               Foreground="{Binding CouleurEcart}"
                                               FontSize="12" FontWeight="Black"
                                               HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding EcartPts}"
                                               Foreground="#5A5A5A"
                                               FontSize="9"
                                               HorizontalAlignment="Right"/>
                                </StackPanel>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ══ BOTTOM NAV ══ -->
        <Border Grid.Row="6" Background="#111111"
                BorderBrush="#2A2A2A" BorderThickness="0,1,0,0">
            <Grid Margin="0,8,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LIVE -->
                <StackPanel Grid.Column="0" HorizontalAlignment="Center"
                            Cursor="Hand" MouseLeftButtonDown="Nav_Live_Click">
                    <TextBlock Text="📡" FontSize="20" HorizontalAlignment="Center"/>
                    <TextBlock Text="LIVE" Foreground="#E8002D" FontSize="8"
                               FontWeight="Black" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    <Border Height="2" Width="20" CornerRadius="1"
                            HorizontalAlignment="Center" Margin="0,3,0,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#E8002D" Offset="0"/>
                                <GradientStop Color="#FF6B6B" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </StackPanel>

                <!-- STANDINGS -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Center"
                            Cursor="Hand" MouseLeftButtonDown="Nav_Standings_Click">
                    <TextBlock Text="📊" FontSize="20" HorizontalAlignment="Center"/>
                    <TextBlock Text="STANDINGS" Style="{StaticResource NavText}"/>
                </StackPanel>

                <!-- NEWS -->
                <StackPanel Grid.Column="2" HorizontalAlignment="Center"
                            Cursor="Hand" MouseLeftButtonDown="Nav_News_Click">
                    <TextBlock Text="📰" FontSize="20" HorizontalAlignment="Center"/>
                    <TextBlock Text="NEWS" Style="{StaticResource NavText}"/>
                </StackPanel>

                <!-- CALENDAR -->
                <StackPanel Grid.Column="3" HorizontalAlignment="Center"
                            Cursor="Hand" MouseLeftButtonDown="Nav_Calendar_Click">
                    <TextBlock Text="📅" FontSize="20" HorizontalAlignment="Center"/>
                    <TextBlock Text="CALENDAR" Style="{StaticResource NavText}"/>
                </StackPanel>

                <!-- HUB -->
                <StackPanel Grid.Column="4" HorizontalAlignment="Center"
                            Cursor="Hand" MouseLeftButtonDown="Nav_Hub_Click">
                    <TextBlock Text="⚙" FontSize="20" Foreground="#5A5A5A"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="HUB" Style="{StaticResource NavText}"/>
                </StackPanel>

            </Grid>
        </Border>

    </Grid>
</Window>