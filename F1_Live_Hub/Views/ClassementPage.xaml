            </StackPanel>
        </ScrollViewer>

        <!-- ═══ BOTTOM NAV ═══ -->
        <Border Grid.Row="6" Background="#0F0F0F"
                BorderBrush="#1E1E1E" BorderThickness="0,1,0,0" Height="75">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Cursor="Hand" MouseLeftButtonDown="Nav_Stats_Click">
                    <TextBlock Text="📊" FontSize="22" HorizontalAlignment="Center"/>
                    <TextBlock Text="STATS" Foreground="White" FontSize="8" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Top"
                        Width="58" Height="58" CornerRadius="29" Background="#E8002D"
                        Margin="0,-20,0,0" Cursor="Hand" MouseLeftButtonDown="Nav_Live_Click">
