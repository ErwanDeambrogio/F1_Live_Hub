                            <ColumnDefinition Width="38"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="55"/>
                            <ColumnDefinition Width="75"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#358C75" Width="3" CornerRadius="2" HorizontalAlignment="Left" Margin="0,8,0,8"/>
                        <TextBlock Grid.Column="1" Text="08" Foreground="#8A8A8A" FontSize="16" FontWeight="Bold" FontStyle="Italic" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,10"/>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,10,0,10">
                            <TextBlock Text="F. ALONSO" Foreground="White" FontSize="13" FontWeight="Bold"/>
