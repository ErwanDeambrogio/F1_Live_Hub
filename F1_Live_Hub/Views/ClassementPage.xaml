                        </StackPanel>
                        <TextBlock Grid.Column="3" Text="240" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10"/>
                        <TextBlock Grid.Column="4" Text="-335 pts" Foreground="#8A8A8A" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,10"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,6,0,0">
                    <Grid Margin="0,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="38"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="55"/>
                            <ColumnDefinition Width="75"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#FF8000" Width="3" CornerRadius="2" HorizontalAlignment="Left" Margin="0,8,0,8"/>
                        <TextBlock Grid.Column="1" Text="05" Foreground="#8A8A8A" FontSize="16" FontWeight="Bold" FontStyle="Italic" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,10"/>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,10,0,10">
                            <TextBlock Text="L. NORRIS" Foreground="White" FontSize="13" FontWeight="Bold"/>
                            <TextBlock Text="McLaren F1" Foreground="#8A8A8A" FontSize="10" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="3" Text="231" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10"/>
                        <TextBlock Grid.Column="4" Text="-344 pts" Foreground="#8A8A8A" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,10"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,6,0,0">
                    <Grid Margin="0,0,12,0">
