<Window x:Class="F1_Live_Hub.Views.ClassementPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:F1_Live_Hub.Views"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Title="F1 Live Hub - Classement" Height="900" Width="420"
        Background="#0D0D0D" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#111111"
                BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
            <Grid Margin="14,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#E8002D" CornerRadius="6" Width="26" Height="26">
                        <TextBlock Text="F1" Foreground="White" FontSize="10"
                                   FontWeight="Bold" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock VerticalAlignment="Center" Margin="8,0,0,0">
                        <Run Text="F1 " Foreground="White" FontSize="17" FontWeight="Bold"/>
                        <Run Text="LIVE " Foreground="#E8002D" FontSize="17" FontWeight="Bold"/>
                        <Run Text="HUB" Foreground="White" FontSize="17" FontWeight="Bold"/>
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Border Background="#1A1A1A" CornerRadius="20"
                            Width="34" Height="34" Margin="0,0,8,0">
                        <TextBlock Text="🔔" FontSize="14"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <Border Background="#2A2A2A" CornerRadius="20" Width="34" Height="34">
                        <TextBlock Text="👤" FontSize="14"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- FILTRES -->
        <Border Grid.Row="1" Background="#111111"
                BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="14,8">
                <Border Background="#1A1A1A" BorderBrush="#333333"
                        BorderThickness="1" CornerRadius="6" Margin="0,0,8,0"
                        Cursor="Hand" MouseLeftButtonDown="BtnAnnee_Click">
                    <StackPanel Orientation="Horizontal" Margin="10,5">
                        <TextBlock Text="2024" Foreground="White"
                                   FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text=" ▾" Foreground="#8A8A8A"
                                   FontSize="10" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Background="#1A1A1A" BorderBrush="#333333"
                        BorderThickness="1" CornerRadius="6" Margin="0,0,8,0"
                        Cursor="Hand" MouseLeftButtonDown="BtnGP_Click">
                    <StackPanel Orientation="Horizontal" Margin="10,5">
                        <Ellipse Fill="#E8002D" Width="7" Height="7"
                                 VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Monaco GP" Foreground="White"
                                   FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text=" ▾" Foreground="#8A8A8A"
                                   FontSize="10" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Background="#1A1A1A" BorderBrush="#333333"
                        BorderThickness="1" CornerRadius="6"
                        Cursor="Hand" MouseLeftButtonDown="BtnSession_Click">
                    <StackPanel Orientation="Horizontal" Margin="10,5">
                        <TextBlock Text="Qualifying" Foreground="White"
                                   FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text=" ▾" Foreground="#8A8A8A"
                                   FontSize="10" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- TABS -->
        <Border Grid.Row="2" Background="#111111"
                BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Classement" Foreground="White" FontSize="12"
                               FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10"/>
                    <Border Background="#E8002D" Height="2" CornerRadius="1"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Cursor="Hand"
                            MouseLeftButtonDown="Tab_Pilotes_Click">
                    <TextBlock Text="Pilotes" Foreground="#5A5A5A"
                               FontSize="12" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,10"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Cursor="Hand"
                            MouseLeftButtonDown="Tab_Course_Click">
                    <TextBlock Text="Course" Foreground="#5A5A5A"
                               FontSize="12" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,10"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Cursor="Hand"
                            MouseLeftButtonDown="Tab_Meteo_Click">
                    <TextBlock Text="Météo" Foreground="#5A5A5A"
                               FontSize="12" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,10"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- LIVE SESSION BAR -->
        <Border Grid.Row="3" Background="#1A1A1A"
                BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
            <Grid Margin="14,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Fill="#E8002D" Width="7" Height="7"
                             VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="LIVE SESSION" Foreground="White"
                               FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Foreground="#8A8A8A" FontSize="10"
                           FontWeight="Bold" VerticalAlignment="Center"
                           HorizontalAlignment="Center">
                    <Run Text="LAP "/><Run Text="52" Foreground="White"/><Run Text=" / 78"/>
                </TextBlock>
                <TextBlock Grid.Column="2" Foreground="#8A8A8A" FontSize="10"
                           FontWeight="Bold" VerticalAlignment="Center">
                    <Run Text="TRACK TEMP: "/><Run Text="42°C" Foreground="White"/>
                </TextBlock>
            </Grid>
        </Border>

        <!-- HEADER COLONNES -->
        <Border Grid.Row="4" Background="#0D0D0D">
            <Grid Margin="22,6,12,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="55"/>
                    <ColumnDefinition Width="75"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="POS" Foreground="#5A5A5A"
                           FontSize="9" FontWeight="Bold"/>
                <TextBlock Grid.Column="2" Text="PILOTE / ÉQUIPE" Foreground="#5A5A5A"
                           FontSize="9" FontWeight="Bold" Margin="4,0,0,0"/>
                <TextBlock Grid.Column="3" Text="PTS" Foreground="#5A5A5A"
                           FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="4" Text="ÉCART" Foreground="#5A5A5A"
                           FontSize="9" FontWeight="Bold" HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- LISTE 22 PILOTES -->
        <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto" Background="#0D0D0D">
            <StackPanel Margin="12,0,12,12">

                <!-- P1 VERSTAPPEN -->
                <Border Style="{StaticResource Card}" Margin="0,6,0,0">
                    <Grid Margin="0,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="38"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="55"/>
                            <ColumnDefinition Width="75"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#3B6FE8" Width="3" CornerRadius="2" HorizontalAlignment="Left" Margin="0,8,0,8"/>
                        <TextBlock Grid.Column="1" Text="01" Foreground="#E8002D" FontSize="18" FontWeight="Bold" FontStyle="Italic" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,10,0,10"/>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,10,0,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="M. VERSTAPPEN" Foreground="White" FontSize="13" FontWeight="Bold"/>
                                <TextBlock Text=" ▲" Foreground="#E8002D" FontSize="10" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Red Bull Racing" Foreground="#8A8A8A" FontSize="10" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,10">
                            <TextBlock Text="575" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <Border Background="#2A2A2A" Height="3" Width="44" CornerRadius="2" Margin="0,3,0,0">
                                <Border Background="#3B6FE8" Height="3" Width="44" CornerRadius="2" HorizontalAlignment="Left"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Grid.Column="4" Text="LEADER" Foreground="#E8002D" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,10,0,10"/>
                    </Grid>
                </Border>

