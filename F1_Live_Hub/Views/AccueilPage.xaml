<Page x:Class="F1_Live_Hub.Views.AccueilPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:F1_Live_Hub.Views"
        mc:Ignorable="d"
        Title="F1 Live Hub"
        Background="#0D0D0D">

    <Page.Resources>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>

        <Style x:Key="TabBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#8A8A8A"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="0,10">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ═══ -->
        <Border Grid.Row="0" Background="#111111"
                BorderBrush="#2A2A2A" BorderThickness="0,0,0,1"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Background="#E8002D" CornerRadius="6"
                            Width="28" Height="28" Margin="0,0,8,0">
                        <TextBlock Text="F1" Foreground="White" FontSize="11"
                                   FontWeight="Bold" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock VerticalAlignment="Center">
                        <Run Text="F1 " Foreground="White" FontSize="18" FontWeight="Bold"/>
                        <Run Text="LIVE " Foreground="#E8002D" FontSize="18" FontWeight="Bold"/>
                        <Run Text="HUB" Foreground="White" FontSize="18" FontWeight="Bold"/>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Border Background="#1A1A1A" CornerRadius="20"
                            Width="36" Height="36" Cursor="Hand"
                            Margin="0,0,8,0">
                        <TextBlock Text="🔍" FontSize="15"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <Border Background="#2A2A2A" CornerRadius="20"
                            Width="36" Height="36" Cursor="Hand">
                        <TextBlock Text="👤" FontSize="15"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ TABS ═══ -->
        <Border Grid.Row="1" Background="#111111"
                BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="ACCUEIL" Foreground="White" FontSize="11"
                               FontWeight="Bold" HorizontalAlignment="Center"
                               Padding="0,10"/>
                    <Border Background="#E8002D" Height="2" CornerRadius="1"/>
                </StackPanel>

                <Button Grid.Column="1" Style="{StaticResource TabBtn}" Content="CLASSEMENT"/>
                <Button Grid.Column="2" Style="{StaticResource TabBtn}" Content="PILOTES"/>
                <Button Grid.Column="3" Style="{StaticResource TabBtn}" Content="COURSE"/>
            </Grid>
        </Border>

        <!-- ═══ SCROLL CONTENT ═══ -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      Background="#0D0D0D">
            <StackPanel Margin="12,12,12,12">

                <!-- HERO : PROCHAINE COURSE -->
                <Border CornerRadius="14" Margin="0,0,0,12"
                        ClipToBounds="True" Height="300">
                    <Grid>
                        <Border>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1A3A3A" Offset="0"/>
                                    <GradientStop Color="#0D2A2A" Offset="0.5"/>
                                    <GradientStop Color="#0A1A0A" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- Tracé circuit -->
                        <Canvas>
                            <Path Stroke="#FFFFFF" StrokeThickness="5"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Opacity="0.85"
                                  Data="M 60,200 C 60,180 80,160 120,150
                                        C 160,140 180,120 175,95
                                        C 170,70 155,60 140,65
                                        C 125,70 115,85 120,100
                                        C 130,125 160,130 190,120
                                        C 230,105 260,80 290,85
                                        C 320,90 340,110 345,135
                                        C 350,160 335,175 315,170
                                        C 290,163 275,145 280,125
                                        C 288,100 310,92 330,100
                                        C 355,110 365,135 360,160
                                        C 352,190 330,205 305,210
                                        C 270,217 230,200 200,205
                                        C 170,210 150,225 130,220
                                        C 100,213 60,220 60,200 Z"/>
                        </Canvas>

                        <!-- Overlay bas -->
                        <Border VerticalAlignment="Bottom">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="Transparent" Offset="0"/>
                                    <GradientStop Color="#CC000000" Offset="0.5"/>
                                    <GradientStop Color="#FF000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel Margin="16,0,16,12">

                                <Border Background="#E8002D" CornerRadius="20"
                                        Padding="10,4" HorizontalAlignment="Left"
                                        Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Fill="White" Width="6" Height="6"
                                                 Margin="0,0,5,0"
                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="PROCHAINE COURSE"
                                                   Foreground="White" FontSize="9"
                                                   FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Foreground="White" FontSize="28"
                                           FontWeight="Bold" FontStyle="Italic"
                                           TextWrapping="Wrap" LineHeight="30"
                                           Margin="0,0,0,4">
                                    GRAND PRIX DE<LineBreak/>GRANDE-BRETAGNE
                                </TextBlock>

                                <TextBlock Text="Silverstone Circuit  •  05-07 Juillet"
                                           Foreground="#CCCCCC" FontSize="12"
                                           Margin="0,0,0,14"/>

                                <!-- Countdown -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="#1A1A1A"
                                            CornerRadius="8" Padding="8,6"
                                            Margin="0,0,3,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock x:Name="CountDays" Text="00"
                                                       Foreground="#E8002D" FontSize="22"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="JOURS" Foreground="#8A8A8A"
                                                       FontSize="8" FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Background="#1A1A1A"
                                            CornerRadius="8" Padding="8,6"
                                            Margin="3,0,3,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock x:Name="CountHours" Text="00"
                                                       Foreground="#E8002D" FontSize="22"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="HEURES" Foreground="#8A8A8A"
                                                       FontSize="8" FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Background="#1A1A1A"
                                            CornerRadius="8" Padding="8,6"
                                            Margin="3,0,3,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock x:Name="CountMins" Text="00"
                                                       Foreground="#E8002D" FontSize="22"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="MINS" Foreground="#8A8A8A"
                                                       FontSize="8" FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="3" Background="#1A1A1A"
                                            CornerRadius="8" Padding="8,6"
                                            Margin="3,0,0,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock x:Name="CountSecs" Text="00"
                                                       Foreground="#E8002D" FontSize="22"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="SECS" Foreground="#8A8A8A"
                                                       FontSize="8" FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- SESSION LIVE + HIGHLIGHTS -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#2A1010"
                                        CornerRadius="10" Width="42" Height="42">
                                    <TextBlock Text="📡" FontSize="18"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <Border Grid.Column="1" Background="#E8002D"
                                        CornerRadius="4" Padding="5,2"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="LIVE" Foreground="White"
                                               FontSize="8" FontWeight="Bold"/>
                                </Border>
                            </Grid>
                            <TextBlock Text="Session Live" Foreground="White"
                                       FontSize="13" FontWeight="Bold"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="Aucune session en cours"
                                       Foreground="#8A8A8A" FontSize="10"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
                        <StackPanel>
                            <Border Background="#1A2A4A" CornerRadius="10"
                                    Width="42" Height="42"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,16">
                                <TextBlock Text="▶" Foreground="#4A9EFF"
                                           FontSize="16" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="3,0,0,0"/>
                            </Border>
                            <TextBlock Text="Highlights" Foreground="White"
                                       FontSize="13" FontWeight="Bold"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="GP de Monaco 2024"
                                       Foreground="#8A8A8A" FontSize="10"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- CLASSEMENT PILOTES -->
                <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
                    <StackPanel>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="CLASSEMENT PILOTES"
                                       Foreground="White" FontSize="12"
                                       FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="›" Foreground="#8A8A8A"
                                       FontSize="20" VerticalAlignment="Center"
                                       Cursor="Hand"/>
                        </Grid>

                        <!-- P1 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="01"
                                       Foreground="#E8002D" FontSize="13"
                                       FontWeight="Bold" FontStyle="Italic"
                                       VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="#3B6FE8"
                                    Width="3" CornerRadius="2"/>
                            <TextBlock Grid.Column="2" Text="M. VERSTAPPEN"
                                       Foreground="White" FontSize="14"
                                       FontWeight="Bold" VerticalAlignment="Center"
                                       Margin="10,0,0,0"/>
                            <TextBlock Grid.Column="3" Text="194 PTS"
                                       Foreground="White" FontSize="13"
                                       FontWeight="Bold" FontStyle="Italic"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <Border Background="#2A2A2A" Height="1" Margin="0,0,0,10"/>

                        <!-- P2 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="02"
                                       Foreground="#8A8A8A" FontSize="13"
                                       FontWeight="Bold" FontStyle="Italic"
                                       VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="#E8002D"
                                    Width="3" CornerRadius="2"/>
                            <TextBlock Grid.Column="2" Text="C. LECLERC"
                                       Foreground="White" FontSize="14"
                                       FontWeight="Bold" VerticalAlignment="Center"
                                       Margin="10,0,0,0"/>
                            <TextBlock Grid.Column="3" Text="138 PTS"
                                       Foreground="White" FontSize="13"
                                       FontWeight="Bold" FontStyle="Italic"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <Border Background="#2A2A2A" Height="1" Margin="0,0,0,10"/>

                        <!-- P3 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="03"
                                       Foreground="#8A8A8A" FontSize="13"
                                       FontWeight="Bold" FontStyle="Italic"
                                       VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="#FF8C00"
                                    Width="3" CornerRadius="2"/>
                            <TextBlock Grid.Column="2" Text="L. NORRIS"
                                       Foreground="White" FontSize="14"
                                       FontWeight="Bold" VerticalAlignment="Center"
                                       Margin="10,0,0,0"/>
                            <TextBlock Grid.Column="3" Text="131 PTS"
                                       Foreground="White" FontSize="13"
                                       FontWeight="Bold" FontStyle="Italic"
                                       VerticalAlignment="Center"/>
                        </Grid>

                    </StackPanel>
                </Border>

                <!-- PILOTE À L'AFFICHE -->
                <Border CornerRadius="12" ClipToBounds="True" Height="160">
                    <Grid>
                        <Border>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#1A0A0A" Offset="0"/>
                                    <GradientStop Color="#2A1515" Offset="0.5"/>
                                    <GradientStop Color="#3A2020" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="16,16,0,16"
                                        VerticalAlignment="Center">
                                <TextBlock Text="PILOTE À L'AFFICHE"
                                           Foreground="#E8002D" FontSize="9"
                                           FontWeight="Bold" Margin="0,0,0,8"/>
                                <TextBlock Foreground="White" FontSize="26"
                                           FontWeight="Bold" FontStyle="Italic"
                                           LineHeight="28">
                                    CHARLES<LineBreak/>LECLERC
                                </TextBlock>
                                <Border Background="#2A2A2A" CornerRadius="4"
                                        Padding="6,3" HorizontalAlignment="Left"
                                        Margin="0,10,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="#E8002D" CornerRadius="2"
                                                Padding="3,1" Margin="0,0,6,0">
                                            <TextBlock Text="MC" Foreground="White"
                                                       FontSize="8" FontWeight="Bold"/>
                                        </Border>
                                        <TextBlock Text="Scuderia Ferrari"
                                                   Foreground="#CCCCCC" FontSize="10"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <Border Grid.Column="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#4A4A4A" Offset="0"/>
                                        <GradientStop Color="#2A2A2A" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="👤" FontSize="64"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Bottom"
                                           Opacity="0.6" Margin="0,0,0,-8"/>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ═══ BOTTOM NAV ═══ -->
        <Border Grid.Row="3" Background="#111111"
                BorderBrush="#2A2A2A" BorderThickness="0,1,0,0"
                Padding="0,8,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ACCUEIL actif -->
                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="🏠" FontSize="20" HorizontalAlignment="Center"/>
                    <TextBlock Text="ACCUEIL" Foreground="#E8002D"
                               FontSize="8" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    <Border Background="#E8002D" Height="2" Width="20"
                            CornerRadius="1" HorizontalAlignment="Center"
                            Margin="0,3,0,0"/>
                </StackPanel>

                <!-- LIVE -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="📡" FontSize="20" HorizontalAlignment="Center"/>
                    <TextBlock Text="LIVE" Foreground="#5A5A5A"
                               FontSize="8" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- STATS -->
                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="📊" FontSize="20" HorizontalAlignment="Center"/>
                    <TextBlock Text="STATS" Foreground="#5A5A5A"
                               FontSize="8" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- COURSES -->
                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                    <TextBlock Text="🏎" FontSize="20" HorizontalAlignment="Center"/>
                    <TextBlock Text="COURSES" Foreground="#5A5A5A"
                               FontSize="8" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- PROFIL -->
                <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                    <TextBlock Text="👤" FontSize="20" HorizontalAlignment="Center"/>
                    <TextBlock Text="PROFIL" Foreground="#5A5A5A"
                               FontSize="8" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>

            </Grid>
        </Border>

    </Grid>
</Page>