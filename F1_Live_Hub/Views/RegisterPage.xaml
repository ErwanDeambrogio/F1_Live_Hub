<Window x:Class="F1_Live_Hub.Views.RegisterPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="F1 Live Hub - Création de compte" Height="900" Width="420"
        WindowStyle="SingleBorderWindow" ResizeMode="CanMinimize">

    <Grid>

        <!-- FOND DÉGRADÉ ROUGE SOMBRE -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1A0000" Offset="0"/>
                <GradientStop Color="#0D0000" Offset="0.5"/>
                <GradientStop Color="#110000" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- GLOW ROUGE HAUT GAUCHE -->
        <Ellipse Width="350" Height="350"
                 HorizontalAlignment="Left" VerticalAlignment="Top"
                 Margin="-100,-100,0,0" Opacity="0.15">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#E10600" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- GLOW ROUGE BAS DROITE -->
        <Ellipse Width="300" Height="300"
                 HorizontalAlignment="Right" VerticalAlignment="Bottom"
                 Margin="0,0,-80,-80" Opacity="0.12">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#E10600" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <ScrollViewer VerticalScrollBarVisibility="Hidden">
            <StackPanel>

                <!-- ═══════════════════════════════ -->
                <!-- TOP BAR                         -->
                <!-- ═══════════════════════════════ -->
                <Grid Margin="20,20,20,0" Height="50">

                    <!-- Bouton retour rond -->
                    <Border Width="42" Height="42" CornerRadius="21"
                            Background="#22FFFFFF" HorizontalAlignment="Left"
                            VerticalAlignment="Center" Cursor="Hand">
                        <TextBlock Text="❮" Foreground="White" FontSize="16"
                                   FontWeight="Bold" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <!-- Telemetry Active -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="10" Height="10" Fill="#E10600" Margin="0,0,8,0"/>
                        <TextBlock Text="TELEMETRY ACTIVE" Foreground="#AAAAAA"
                                   FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- ═══════════════════════════════ -->
                <!-- TITRE F1 LIVE HUB               -->
                <!-- ═══════════════════════════════ -->
                <StackPanel HorizontalAlignment="Center" Margin="0,28,0,28">
                    <TextBlock Text="F1  LIVE  HUB" Foreground="White"
                               FontSize="22" FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                    <Rectangle Height="3" Width="80" Fill="#E10600"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0" RadiusX="2" RadiusY="2"/>
                </StackPanel>

                <!-- ═══════════════════════════════ -->
                <!-- CARTE FORMULAIRE                -->
                <!-- ═══════════════════════════════ -->
                <Border Margin="20,0,20,0" CornerRadius="18" Padding="26,28">
                    <Border.Background>
                        <SolidColorBrush Color="#1E1E1E"/>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect Color="#E10600" BlurRadius="30"
                                          Opacity="0.1" ShadowDepth="0"/>
                    </Border.Effect>

                    <StackPanel>

                        <!-- Damier coin haut droit -->
                        <Grid HorizontalAlignment="Right" Width="44" Height="28" Margin="0,-8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Rectangle Grid.Row="0" Grid.Column="0" Fill="#555" Margin="1"/>
                            <Rectangle Grid.Row="0" Grid.Column="1" Fill="#222" Margin="1"/>
                            <Rectangle Grid.Row="0" Grid.Column="2" Fill="#555" Margin="1"/>
                            <Rectangle Grid.Row="0" Grid.Column="3" Fill="#222" Margin="1"/>
                            <Rectangle Grid.Row="1" Grid.Column="0" Fill="#222" Margin="1"/>
                            <Rectangle Grid.Row="1" Grid.Column="1" Fill="#555" Margin="1"/>
                            <Rectangle Grid.Row="1" Grid.Column="2" Fill="#222" Margin="1"/>
                            <Rectangle Grid.Row="1" Grid.Column="3" Fill="#555" Margin="1"/>
                        </Grid>

                        <!-- Titre carte -->
                        <TextBlock Text="CRÉATION DE COMPTE" Foreground="White"
                                   FontSize="24" FontWeight="Bold" FontStyle="Italic"
                                   Margin="0,4,0,28"/>

                        <!-- ─── NOM D'UTILISATEUR ─── -->
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="NOM D'UTILISATEUR" Foreground="#CCCCCC"
                                       FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="👤" FontSize="14" Foreground="#E10600"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                        <Border Background="#1C1C1C" CornerRadius="10"
                                Height="56" Padding="16,0" Margin="0,0,0,20">
                            <Grid>
                                <TextBox Background="Transparent" BorderThickness="0"
                                         Foreground="#666666" FontSize="15"
                                         VerticalAlignment="Center" CaretBrush="White"
                                         Text="Entrez votre nom de pilote"/>
                                <TextBlock Text="🪪" FontSize="16" Foreground="#555555"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- ─── MOT DE PASSE ─── -->
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="MOT DE PASSE" Foreground="#CCCCCC"
                                       FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="🔒" FontSize="14" Foreground="#E10600"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                        <Border Background="#1C1C1C" CornerRadius="10"
                                Height="56" Padding="16,0" Margin="0,0,0,20">
                            <Grid>
                                <PasswordBox Background="Transparent" BorderThickness="0"
                                             Foreground="#666666" FontSize="15"
                                             VerticalAlignment="Center" CaretBrush="White"
                                             Password="123456789"/>
                                <TextBlock Text="🙈" FontSize="16" Foreground="#555555"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- ─── CONFIRMER MOT DE PASSE ─── -->
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="CONFIRMER LE MOT DE PASSE" Foreground="#CCCCCC"
                                       FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="🛡" FontSize="14" Foreground="#E10600"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                        <Border Background="#1C1C1C" CornerRadius="10"
                                Height="56" Padding="16,0" Margin="0,0,0,30">
                            <Grid>
                                <PasswordBox Background="Transparent" BorderThickness="0"
                                             Foreground="#666666" FontSize="15"
                                             VerticalAlignment="Center" CaretBrush="White"
                                             Password="123456789"/>
                                <TextBlock Text="🛡" FontSize="16" Foreground="#555555"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- ─── BOUTON CRÉER MON COMPTE ─── -->
                        <Button Cursor="Hand" BorderThickness="0"
                                Background="Transparent" Margin="0,0,0,20"
                                HorizontalAlignment="Stretch">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="12" Height="60">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#E10600" Offset="0"/>
                                                <GradientStop Color="#FF2200" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border.Effect>
                                            <DropShadowEffect Color="#E10600" BlurRadius="22"
                                                              Opacity="0.5" ShadowDepth="0"/>
                                        </Border.Effect>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="CRÉER MON COMPTE" Foreground="White"
                                                       FontSize="15" FontWeight="Bold"
                                                       FontStyle="Italic" VerticalAlignment="Center"/>
                                            <TextBlock Text="  🏁" FontSize="18"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- ─── RETOUR CONNEXION ─── -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,4,0,0" Cursor="Hand">
                            <TextBlock Text="→  " Foreground="#888888" FontSize="13"/>
                            <TextBlock Text="Retour à la connexion"
                                       Foreground="#AAAAAA" FontSize="13"/>
                        </StackPanel>

                    </StackPanel>
                </Border>

                <!-- ═══════════════════════════════ -->
                <!-- BARRES TELEMETRIE               -->
                <!-- ═══════════════════════════════ -->
                <Grid Margin="40,36,40,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="ENGINE" Foreground="#888888" FontSize="10"
                                   FontWeight="Bold" HorizontalAlignment="Center"
                                   Margin="0,0,0,6"/>
                        <Rectangle Height="2" Fill="#E10600" RadiusX="1" RadiusY="1"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="TIRES" Foreground="#888888" FontSize="10"
                                   FontWeight="Bold" HorizontalAlignment="Center"
                                   Margin="0,0,0,6"/>
                        <Rectangle Height="2" Fill="#E10600" RadiusX="1" RadiusY="1"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock Text="ERS" Foreground="#888888" FontSize="10"
                                   FontWeight="Bold" HorizontalAlignment="Center"
                                   Margin="0,0,0,6"/>
                        <Rectangle Height="2" Fill="#E10600" RadiusX="1" RadiusY="1"/>
                    </StackPanel>
                </Grid>

                <!-- ═══════════════════════════════ -->
                <!-- COPYRIGHT                       -->
                <!-- ═══════════════════════════════ -->
                <TextBlock Text="FIA FORMULA 1 WORLD CHAMPIONSHIP © 2024"
                           Foreground="#444444" FontSize="9" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,24"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>